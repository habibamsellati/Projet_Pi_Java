<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.AdminController"
            stylesheets="@/css/admin_style.css"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" styleClass="sidebar" spacing="0">
            <!-- LOGO AREA -->
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 40 0;">
                <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 30;">
                    <StackPane style="-fx-background-color: #c4956a; -fx-background-radius: 12; -fx-padding: 10;">
                        <Label text="🎨" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT">
                        <Label text="AFK'ART" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900;"/>
                        <Label text="PORTAIL ADMIN" style="-fx-text-fill: #c4956a; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>

            <Label text="NAVIGATION" style="-fx-text-fill: #6b6b6b; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 30 15 30;"/>

            <Button fx:id="btnNavDashboard" text="📊  Dashboard" maxWidth="Infinity" onAction="#showDashboardView">
                <styleClass>
                    <String fx:value="nav-button"/>
                    <String fx:value="nav-button-active"/>
                </styleClass>
            </Button>
            <Button fx:id="btnNavEvenements" text="📅  Événements" maxWidth="Infinity" styleClass="nav-button" onAction="#showEvenementsView"/>
            <Button fx:id="btnNavReservations" text="🎟️  Réservations" maxWidth="Infinity" styleClass="nav-button" onAction="#showReservationsView"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" style="-fx-padding: 20 30;">
                <Button text="🚪 Déconnexion" maxWidth="Infinity" styleClass="btn-secondary"
                        style="-fx-text-fill: #e53e3e; -fx-border-color: #fed7d7;"
                        onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox style="-fx-background-color: #f7f3f0;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="25" styleClass="header-bar"
                  style="-fx-padding: 20 40;">
                <VBox>
                    <Label fx:id="lblViewTitle" text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #2d2d2d;"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Circle radius="3" fill="#c4956a"/>
                        <Label fx:id="lblViewSubtitle" text="Overview &amp; Analytics" style="-fx-font-size: 12px; -fx-text-fill: #9e8e82;"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="glass-pane" style="-fx-padding: 8 20;">
                    <Label text="🔍" style="-fx-opacity: 0.5;"/>
                    <TextField promptText="Rechercher..." style="-fx-background-color: transparent; -fx-padding: 0; -fx-pref-width: 180; -fx-border-color: transparent; -fx-background-radius: 0;"/>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="30" style="-fx-opacity: 0.3;"/>

                <HBox alignment="CENTER" spacing="12">
                    <VBox alignment="CENTER_RIGHT">
                        <Label text="Admin User" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2d2d2d;"/>
                        <Label text="Administrateur" style="-fx-font-size: 10px; -fx-text-fill: #c4956a;"/>
                    </VBox>
                    <StackPane style="-fx-background-color: #c4956a; -fx-background-radius: 25; -fx-min-width: 42; -fx-min-height: 42;">
                        <Label text="AD" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12px;"/>
                    </StackPane>
                </HBox>
            </HBox>

            <!-- DYNAMIC CONTENT AREA -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-padding: 30 40;">
                <!-- Content loaded here -->
            </StackPane>

        </VBox>
    </center>

</BorderPane>
