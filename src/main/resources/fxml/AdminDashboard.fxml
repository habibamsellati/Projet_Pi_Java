<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.example.controllers.AdminDashboardController"
        stylesheets="@/css/admin-dashboard.css"
        prefWidth="1200" prefHeight="780">

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <left>
        <VBox styleClass="sidebar" spacing="1">
            <!-- Logo -->
            <HBox styleClass="logo-box">
                <Label text="🎨" styleClass="logo-icon"/>
                <Label text="afk'art" styleClass="logo-text"/>
            </HBox>

            <Label text="MENU PRINCIPAL" styleClass="nav-section-lbl"/>

            <Button fx:id="btnNavDashboard" text="⊞  Dashboard"
                    styleClass="nav-btn,nav-btn-active" maxWidth="Infinity"
                    onAction="#handleNavDashboard"/>
            <Button text="👥  Utilisateurs"         styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnNavProduits" text="♻  Produits recyclables"  styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavProduits"/>
            <Button fx:id="btnNavPropositions" text="📋  Propositions"  styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavPropositions"/>
            <Button text="🚚  Livraisons"            styleClass="nav-btn" maxWidth="Infinity"/>
            <Button text="🏠  Suivi Livraisons"      styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnNavReclamations" text="⚠  Réclamations"  styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavReclamations"/>
            <Button text="🔧  Artisans"              styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnNavArticles" text="📰  Articles"  styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavArticles"/>
            <Button fx:id="btnNavCommandes" text="🛒  Commandes"  styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavCommandes"/>
            <Button fx:id="btnNavEvenements" text="🎭  Événements"
                    styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavEvenements"/>
            <Button fx:id="btnNavReservations" text="📅  Réservations"
                    styleClass="nav-btn" maxWidth="Infinity"
                    onAction="#handleNavReservations"/>

            <Label text="Liste validée des articles" styleClass="nav-sub-lbl"/>
            <Button text="📁  Catégories" styleClass="nav-btn" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Déconnexion"
                    styleClass="nav-btn,nav-logout" maxWidth="Infinity"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ═══════════ MAIN ═══════════ -->
    <center>
        <VBox>
            <!-- TOPBAR -->
            <HBox styleClass="topbar">
                <VBox spacing="2">
                    <Label fx:id="topbarTitle" text="Dashboard" styleClass="topbar-title"/>
                    <Label fx:id="lblBienvenue" text="Bienvenue, Administrateur" styleClass="topbar-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="search-box">
                    <Label text="🔍" style="-fx-text-fill:#a09890; -fx-font-size:14;"/>
                    <TextField promptText="Rechercher..." styleClass="search-input"/>
                </HBox>
                <HBox styleClass="user-pill">
                    <Label fx:id="lblAvatar" text="AD" styleClass="avatar-lbl"/>
                    <VBox spacing="1">
                        <Label fx:id="lblNomAdmin" text="Admin" styleClass="user-name-lbl"/>
                        <Label text="Super Admin" styleClass="user-role-lbl"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- SCROLLABLE CONTENT -->
            <ScrollPane fx:id="scrollContent" fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox fx:id="dashboardContent" styleClass="content-area">
                    <padding><Insets top="20" right="32" bottom="32" left="32"/></padding>

                    <!-- ── STAT CARDS ── -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="16.66"/>
                        </columnConstraints>

                        <!-- Utilisateurs -->
                        <VBox styleClass="stat-card" GridPane.columnIndex="0">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <Label text="👥" styleClass="stat-icon-box,ic-purple"/>
                                <VBox spacing="4">
                                    <Label fx:id="lblTotalUsers" text="0" styleClass="stat-val"/>
                                    <Label text="Utilisateurs" styleClass="stat-lbl"/>
                                    <Label fx:id="badgeUsers" text="↗ chargement…" styleClass="badge-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Oeuvres -->
                        <VBox styleClass="stat-card" GridPane.columnIndex="1">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <Label text="🖼" styleClass="stat-icon-box,ic-brown"/>
                                <VBox spacing="4">
                                    <Label fx:id="lblTotalOeuvres" text="0" styleClass="stat-val"/>
                                    <Label text="Oeuvres" styleClass="stat-lbl"/>
                                    <Label fx:id="badgeOeuvres" text="↗ chargement…" styleClass="badge-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Artisans -->
                        <VBox styleClass="stat-card" GridPane.columnIndex="2">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <Label text="🔨" styleClass="stat-icon-box,ic-green"/>
                                <VBox spacing="4">
                                    <Label fx:id="lblTotalArtisans" text="0" styleClass="stat-val"/>
                                    <Label text="Artisans" styleClass="stat-lbl"/>
                                    <Label fx:id="badgeArtisans" text="↗ chargement…" styleClass="badge-up"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Réclamations -->
                        <VBox styleClass="stat-card" GridPane.columnIndex="3">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <Label text="⚠" styleClass="stat-icon-box,ic-orange"/>
                                <VBox spacing="4">
                                    <Label fx:id="lblTotalReclamations" text="0" styleClass="stat-val"/>
                                    <Label text="Réclamations" styleClass="stat-lbl"/>
                                    <Label fx:id="badgeReclamations" text="↘ chargement…" styleClass="badge-dn"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Total Commandes -->
                        <VBox styleClass="stat-card" GridPane.columnIndex="4">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <Label text="🛒" styleClass="stat-icon-box,ic-purple"/>
                                <VBox spacing="4">
                                    <Label fx:id="lblTotalCommandes" text="0" styleClass="stat-val"/>
                                    <Label text="Commandes" styleClass="stat-lbl"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Chiffre d'affaires -->
                        <VBox styleClass="stat-card" GridPane.columnIndex="5">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <Label text="💰" styleClass="stat-icon-box,ic-brown"/>
                                <VBox spacing="4">
                                    <Label fx:id="lblChiffreAffaires" text="0 DT" styleClass="stat-val"/>
                                    <Label text="Chiffre d'affaires" styleClass="stat-lbl"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <!-- ── CHARTS ROW ── -->
                    <HBox spacing="16">

                        <!-- Activité -->
                        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="Activité de la plateforme" styleClass="chart-title-lbl"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox styleClass="tabs-box" spacing="4">
                                    <Button fx:id="btn7j"  text="7 jours"  styleClass="tab-btn,tab-btn-active" onAction="#switchTo7j"/>
                                    <Button fx:id="btn30j" text="30 jours" styleClass="tab-btn" onAction="#switchTo30j"/>
                                    <Button fx:id="btn12m" text="12 mois"  styleClass="tab-btn" onAction="#switchTo12m"/>
                                </HBox>
                            </HBox>

                            <LineChart fx:id="lineChart" prefHeight="230" animated="false" legendVisible="false">
                                <xAxis><CategoryAxis fx:id="lineXAxis"/></xAxis>
                                <yAxis><NumberAxis fx:id="lineYAxis"/></yAxis>
                            </LineChart>

                            <HBox styleClass="chart-legend-row">
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="●" styleClass="legend-dot" style="-fx-text-fill:#4a1e2e;"/>
                                    <Label text="Utilisateurs" styleClass="legend-text"/>
                                </HBox>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="●" styleClass="legend-dot" style="-fx-text-fill:#c8763a;"/>
                                    <Label text="Oeuvres" styleClass="legend-text"/>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Donut -->
                        <VBox styleClass="chart-card" prefWidth="290" spacing="12" alignment="TOP_CENTER">
                            <Label text="Répartition des rôles" styleClass="chart-title-lbl" maxWidth="Infinity"/>

                            <StackPane fx:id="pieChartContainer" prefHeight="190" prefWidth="190"
                                       maxWidth="190" alignment="CENTER">
                                <!-- PieChart + cercle blanc injectés par le contrôleur -->
                                <VBox alignment="CENTER" mouseTransparent="true" spacing="2">
                                    <Label fx:id="lblTotalRoles" text="0" styleClass="donut-total-lbl"/>
                                    <Label text="Total" styleClass="donut-sub-lbl"/>
                                </VBox>
                            </StackPane>

                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="●" style="-fx-text-fill:#4a1e2e; -fx-font-size:14;"/>
                                    <Label text="Clients"  styleClass="legend-role-lbl" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblPctClients"  text="0%" styleClass="legend-pct-lbl"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="●" style="-fx-text-fill:#c8763a; -fx-font-size:14;"/>
                                    <Label text="Artisans" styleClass="legend-role-lbl" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblPctArtisans" text="0%" styleClass="legend-pct-lbl"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="●" style="-fx-text-fill:#22a050; -fx-font-size:14;"/>
                                    <Label text="Admins"   styleClass="legend-role-lbl" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblPctAdmins"   text="0%" styleClass="legend-pct-lbl"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- ── BOTTOM ROW ── -->
                    <HBox spacing="16">
                        <VBox styleClass="table-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Utilisateurs récents" styleClass="sec-hdr-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Voir tout" styleClass="voir-tout-lbl"/>
                            </HBox>
                            <VBox fx:id="recentUsersContainer" spacing="0"/>
                        </VBox>
                        <VBox styleClass="table-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Activité récente" styleClass="sec-hdr-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Voir tout" styleClass="voir-tout-lbl"/>
                            </HBox>
                            <VBox fx:id="recentActivityContainer" spacing="0"/>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
