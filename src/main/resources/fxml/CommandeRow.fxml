<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CommandeRowController"
      spacing="0" alignment="CENTER_LEFT"
      style="-fx-background-color: white; -fx-border-color: transparent transparent #f0ece6 transparent;
             -fx-border-width: 0 0 1 0; -fx-padding: 12 16;">

    <Label fx:id="lblNumero"
           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a1e2e;"
           prefWidth="180" wrapText="true"/>

    <Label fx:id="lblDate"
           style="-fx-font-size: 12; -fx-text-fill: #7a7570;"
           prefWidth="130"/>

    <Label fx:id="lblClient"
           style="-fx-font-size: 12; -fx-text-fill: #1a1a1a;"
           prefWidth="160" wrapText="true"/>

    <Label fx:id="lblStatut"
           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-background-radius: 20;
                  -fx-padding: 3 10; -fx-text-fill: white;"
           prefWidth="110"/>

    <Label fx:id="lblTotal"
           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #c8763a;"
           prefWidth="110"/>

    <Label fx:id="lblAdresse"
           style="-fx-font-size: 12; -fx-text-fill: #7a7570;"
           HBox.hgrow="ALWAYS" wrapText="true"/>

    <HBox spacing="6" prefWidth="180" alignment="CENTER_RIGHT">
        <Button fx:id="btnValider" text="✅ Valider"
                onAction="#handleValider"
                style="-fx-background-color: #22a050; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 5 12; -fx-cursor: hand; -fx-font-size: 11;"/>
        <Button fx:id="btnInvalider" text="❌ Invalider"
                onAction="#handleInvalider"
                style="-fx-background-color: #dc2626; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 5 12; -fx-cursor: hand; -fx-font-size: 11;"/>
        <Button fx:id="btnModifier" text="✏"
                onAction="#handleModifier"
                style="-fx-background-color: #f5f0eb; -fx-text-fill: #4a1e2e;
                       -fx-background-radius: 6; -fx-padding: 5 10; -fx-cursor: hand; -fx-font-size: 11;"/>
    </HBox>
</HBox>

