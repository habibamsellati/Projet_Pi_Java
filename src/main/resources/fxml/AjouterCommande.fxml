<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-container" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.AjouterCommandeController">
    <content>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 40;">
            <Label text="Créer une Nouvelle Commande" styleClass="title-label"/>
            <Label text="Saisissez les informations de livraison et de paiement" style="-fx-text-fill: #A1887F;"/>

            <VBox spacing="15" style="-fx-max-width: 700; -fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
                <Label text="Adresse de livraison *" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="taAdresseLivraison" prefHeight="120" promptText="Ex: 12 Rue de Carthage, Tunis 1000"/>

                <HBox spacing="20">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Téléphone" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="tfTelephone" promptText="Ex : 20 123 456 ou +21620123456"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Total *" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="tfTotal" promptText="Ex: 120.00"/>
                    </VBox>
                </HBox>

                <HBox spacing="20">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Statut *" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbStatut" maxWidth="Infinity"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Mode de paiement *" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbModePaiement" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <Label text="ID Client" style="-fx-font-weight: bold;"/>
                <TextField fx:id="tfClientId" promptText="Optionnel"/>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Annuler" styleClass="btn-annuler" onAction="#handleAnnuler"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Voir les commandes" onAction="#handleVoirCommandes"/>
                    <Button text="Enregistrer" styleClass="btn-publier" onAction="#handleAjouter"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</ScrollPane>

