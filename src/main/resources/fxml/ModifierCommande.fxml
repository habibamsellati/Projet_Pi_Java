<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="main-container" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.ModifierCommandeController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Modifier la commande" styleClass="title-label"/>

    <Label text="Numéro" style="-fx-font-weight: bold;"/>
    <TextField fx:id="tfNumero" editable="false"/>

    <Label text="Adresse de livraison *" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="taAdresseLivraison" prefHeight="110"/>

    <HBox spacing="12">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Téléphone" style="-fx-font-weight: bold;"/>
            <TextField fx:id="tfTelephone" promptText="Ex : 20 123 456 ou +21620123456"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Total *" style="-fx-font-weight: bold;"/>
            <TextField fx:id="tfTotal"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Statut *" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbStatut" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Mode de paiement *" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbModePaiement" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <Label text="ID Client" style="-fx-font-weight: bold;"/>
    <TextField fx:id="tfClientId" promptText="Optionnel"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Annuler" styleClass="btn-annuler" onAction="#handleAnnuler"/>
        <Button text="Enregistrer" styleClass="btn-publier" onAction="#handleModifier"/>
    </HBox>
</VBox>

