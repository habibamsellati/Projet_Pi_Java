<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16" alignment="CENTER_LEFT" styleClass="article-card" stylesheets="@/css/style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.PanierItemController">

    <ImageView fx:id="ivImage" fitWidth="90" fitHeight="90" preserveRatio="false" smooth="true"/>

    <VBox spacing="5" HBox.hgrow="ALWAYS">
        <Label fx:id="lblTitre" text="Titre de l'article"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #5D4037;" wrapText="true" maxWidth="340"/>
        <Label fx:id="lblAuteur" text="Artisan #1"
               style="-fx-font-size: 13; -fx-text-fill: #A1887F;"/>
        <Label fx:id="lblDate" text="01 janv. 2026"
               style="-fx-font-size: 12; -fx-text-fill: #B7AFA0;"/>
        <Label fx:id="lblPrix" text="0.00 DT"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #8D5E3C;"/>
    </VBox>

    <Region HBox.hgrow="ALWAYS"/>

    <VBox spacing="10" alignment="CENTER">
        <Button text="Voir" styleClass="btn-publier" onAction="#handleVoir" minWidth="90"/>
        <Button text="🗑 Retirer" styleClass="btn-modifier" onAction="#handleRemove" minWidth="90"/>
    </VBox>

    <padding>
        <Insets top="14" right="16" bottom="14" left="14"/>
    </padding>
</HBox>

