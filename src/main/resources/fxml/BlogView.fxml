<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextAlignment?>

<ScrollPane fitToWidth="true"
            stylesheets="@/css/blog-style.css"
            style="-fx-background-color:#F5F0E8; -fx-background:#F5F0E8;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.BlogController">

  <VBox style="-fx-background-color:#F5F0E8;" spacing="0">

    <!-- HERO BANNER -->
    <VBox style="-fx-background-color:#F5F0E8;">
      <padding><Insets top="24" left="48" right="48" bottom="0"/></padding>
      <StackPane styleClass="hero-banner" minHeight="200">
        <padding><Insets top="60" bottom="60" left="40" right="40"/></padding>
        <VBox alignment="CENTER" spacing="16">
          <Label text="Notre Blog" styleClass="hero-title"/>
          <Label styleClass="hero-subtitle" wrapText="true" maxWidth="560"
                 textAlignment="CENTER"
                 text="Découvrez nos articles sur l'artisanat durable, les créateurs locaux et les pratiques écologiques"/>
        </VBox>
      </StackPane>
    </VBox>

    <!-- FILTER BAR -->
    <VBox style="-fx-background-color:#F5F0E8;">
      <padding><Insets top="24" left="48" right="48" bottom="0"/></padding>
      <HBox styleClass="filter-box" alignment="CENTER_LEFT" spacing="14">
        <padding><Insets top="18" bottom="18" left="24" right="24"/></padding>
        <TextField fx:id="searchField" promptText="Rechercher un article..."
                   styleClass="search-field" prefWidth="255" prefHeight="38"/>
        <ComboBox fx:id="categoryCombo" styleClass="filter-combo" prefWidth="190" prefHeight="38"/>
        <ComboBox fx:id="authorCombo" styleClass="filter-combo" prefWidth="170" prefHeight="38"/>
        <ComboBox fx:id="sortCombo" styleClass="filter-combo" prefWidth="205" prefHeight="38"/>
        <Button text="Filtrer" styleClass="btn-filtrer" prefHeight="38" prefWidth="110" onAction="#handleFilter"/>
      </HBox>
    </VBox>

    <!-- ACTION BUTTONS -->
    <VBox style="-fx-background-color:#F5F0E8;">
      <padding><Insets top="20" left="48" right="48" bottom="0"/></padding>
      <HBox spacing="14" alignment="CENTER_LEFT">
        <Button fx:id="btnPanier" text="🛒  Voir le panier" styleClass="btn-panier"
                prefHeight="40" onAction="#handleVoirPanier"/>
        <Button fx:id="btnAjouterArticle"
                text="+ Ajouter un Nouvel Article"
                visible="false" managed="false"
                styleClass="btn-add-article"
                prefHeight="40"
                onAction="#handleAjouterArticle"/>
      </HBox>
    </VBox>

    <!-- SECTION: ARTICLES EN VEDETTE -->
    <VBox style="-fx-background-color:#F5F0E8;">
      <padding><Insets top="32" left="48" right="48" bottom="0"/></padding>
      <Label text="Articles en Vedette" styleClass="section-title"/>
      <VBox><padding><Insets top="8"/></padding></VBox>
      <Separator styleClass="section-sep" maxWidth="Infinity"/>
      <VBox><padding><Insets top="20"/></padding></VBox>

      <GridPane fx:id="featuredGrid" hgap="22" vgap="22">
        <columnConstraints>
          <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
          <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
        </columnConstraints>
      </GridPane>
    </VBox>

    <!-- SECTION: TOUS LES ARTICLES -->
    <VBox style="-fx-background-color:#F5F0E8;">
      <padding><Insets top="40" left="48" right="48" bottom="40"/></padding>
      <Label text="Tous les Articles" styleClass="section-title"/>
      <VBox><padding><Insets top="8"/></padding></VBox>
      <Separator styleClass="section-sep" maxWidth="Infinity"/>
      <VBox><padding><Insets top="20"/></padding></VBox>

      <GridPane fx:id="allGrid" hgap="22" vgap="22">
        <columnConstraints>
          <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
          <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
          <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
        </columnConstraints>
      </GridPane>
    </VBox>

    <!-- FOOTER SEPARATOR -->
    <VBox style="-fx-background-color:#F5F0E8;">
      <padding><Insets left="48" right="48" bottom="24"/></padding>
      <Separator style="-fx-background-color:#DDD5C8;"/>
    </VBox>

  </VBox>
</ScrollPane>

