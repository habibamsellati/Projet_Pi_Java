<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.LoginController"
            stylesheets="@/css/login.css"
            style="-fx-background-color: #f0ebe4;">

    <!-- ── Navbar ─────────────────────────────────────────── -->
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="0">
            <Label text="AfkArt" styleClass="logo-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil"    styleClass="nav-link"/>
            <Button text="Connexion"  styleClass="btn-connexion"/>
            <HBox><padding><Insets left="10"/></padding></HBox>
            <Button text="Rejoindre"  styleClass="btn-rejoindre" onAction="#handleAllerInscription"/>
        </HBox>
    </top>

    <!-- ── Formulaire centré ──────────────────────────────── -->
    <center>
        <StackPane alignment="CENTER">
            <VBox spacing="14" alignment="CENTER"
                  styleClass="form-card"
                  style="-fx-padding: 36 40; -fx-max-width: 480; -fx-min-width: 420;">

                <!-- Titre -->
                <Label text="Se connecter" styleClass="form-title"/>
                <Label text="Accédez à votre compte AfkArt" styleClass="form-subtitle"/>

                <!-- Email -->
                <VBox spacing="6">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="tfEmail"
                               promptText="Entrez votre email"
                               styleClass="input-field"
                               maxWidth="Infinity"/>
                </VBox>

                <!-- Mot de passe -->
                <VBox spacing="6">
                    <Label text="Mot de passe" styleClass="field-label"
                           style="-fx-background-color: transparent; -fx-text-fill: #2f2430;"/>
                    <PasswordField fx:id="pfMotDePasse"
                                   promptText="Entrez votre mot de passe"
                                   styleClass="input-field"
                                   maxWidth="Infinity"/>
                </VBox>

                <!-- CAPTCHA -->
                <VBox spacing="8">
                    <Label text="Captcha"
                           style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#2f2430;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ImageView fx:id="ivCaptcha"
                                   fitWidth="170" fitHeight="55"
                                   preserveRatio="false" smooth="true"
                                   style="-fx-border-color:#dcd5ce;-fx-border-radius:8;"/>
                        <Button text="↻" styleClass="btn-refresh"
                                onAction="#handleRefreshCaptcha"/>
                    </HBox>
                    <TextField fx:id="tfCaptcha"
                               promptText="Recopiez le code"
                               styleClass="captcha-field"
                               maxWidth="Infinity"/>
                </VBox>

                <!-- Message erreur -->
                <Label fx:id="lblInfo" text="" styleClass="error-label"
                       wrapText="true" maxWidth="Infinity"/>

                <!-- Bouton Se connecter -->
                <Button text="Se connecter"
                        onAction="#handleConnexion"
                        styleClass="btn-login"
                        maxWidth="Infinity"/>

                <!-- Séparateur ou continuer avec -->
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 4 0;">
                    <Separator HBox.hgrow="ALWAYS"/>
                    <Label text="ou continuer avec" styleClass="separator-label"/>
                    <Separator HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Google -->
                <Button fx:id="btnGoogle" text="Google"
                        onAction="#handleGoogleLogin"
                        styleClass="btn-google"
                        maxWidth="Infinity"/>

                <!-- Facebook -->
                <Button text="Facebook"
                        styleClass="btn-facebook"
                        maxWidth="Infinity"/>

                <!-- Mot de passe oublié -->
                <Button text="Mot de passe oublié ?"
                        onAction="#handleForgotPassword"
                        styleClass="link-forgot"
                        maxWidth="Infinity"/>

                <!-- S'inscrire -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Pas encore de compte ?"
                           style="-fx-font-size:13;-fx-text-fill:#9a8a7a;"/>
                    <Button text="S'inscrire"
                            styleClass="link-register"
                            onAction="#handleAllerInscription"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
