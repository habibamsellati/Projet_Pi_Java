<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f7f3f0;"
           stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.LoginController">

    <!-- Design décoratif (Bulles/Formes) -->
    <Circle radius="200" fill="#fcf6f2" StackPane.alignment="TOP_RIGHT" translateX="100" translateY="-100" />
    <Circle radius="150" fill="#fcf6f2" StackPane.alignment="BOTTOM_LEFT" translateX="-80" translateY="80" />

    <VBox alignment="CENTER" maxWidth="450" spacing="30" styleClass="form-card"
          style="-fx-padding: 60 40; -fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10);">
        
        <!-- Titre & Logo -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🎨" style="-fx-font-size: 40px; -fx-text-fill: #C4704B;"/>
            <Label text="AFK'ART" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #3D3229;"/>
            <Label text="PORTAIL ARTISANAL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #C4704B; -fx-letter-spacing: 2px;"/>
        </VBox>

        <VBox spacing="20">
            <!-- Email -->
            <VBox spacing="8">
                <Label text="Adresse Email" style="-fx-font-weight: bold; -fx-text-fill: #6b5b4f; -fx-font-size: 13px;"/>
                <TextField fx:id="txtEmail" promptText="exemple@domaine.com" style="-fx-pref-height: 45;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="8">
                <Label text="Mot de Passe" style="-fx-font-weight: bold; -fx-text-fill: #6b5b4f; -fx-font-size: 13px;"/>
                <PasswordField fx:id="txtPassword" onAction="#handleLogin" promptText="••••••••" style="-fx-pref-height: 45;"/>
            </VBox>

            <Label fx:id="lblError" managed="false" style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;" visible="false"/>
        </VBox>

        <VBox spacing="15">
            <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" 
                    style="-fx-background-color: #C4704B; -fx-text-fill: white; -fx-background-radius: 999; -fx-pref-height: 45; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" text="Se Connecter" />
            
            <HBox alignment="CENTER" spacing="5">
                <Label text="Pas encore de compte ?" style="-fx-text-fill: #9e8e82;"/>
                <Label onMouseClicked="#handleGoToRegister" text="Inscrivez-vous" style="-fx-text-fill: #C4704B; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <Separator/>
        
        <Label wrapText="true" textAlignment="CENTER" text="Accédez à la gestion de vos événements et réservations en toute simplicité." 
               style="-fx-text-fill: #9e8e82; -fx-font-size: 11px;"/>
    </VBox>

</StackPane>
