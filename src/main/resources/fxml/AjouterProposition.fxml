<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="main-container"
            stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.AjouterPropositionController">
    <content>
        <VBox spacing="0" alignment="TOP_CENTER"
              style="-fx-padding: 30 60 40 60; -fx-background-color: #F9F7F2;">

            <Label text="Nouvelle proposition"
                   style="-fx-font-family: Georgia; -fx-font-size: 26; -fx-text-fill: #2f2430;
                          -fx-padding: 0 0 20 0;"/>

            <!-- ── Titre ─────────────────────────────────────────── -->
            <VBox spacing="4" style="-fx-padding: 0 0 12 0;">
                <Label text="Titre"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <TextField fx:id="tfTitre" promptText="Titre de la proposition"
                           style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10; -fx-font-size: 13;"/>
            </VBox>

            <!-- ── Description + Régénérer ──────────────────────── -->
            <VBox spacing="4" style="-fx-padding: 0 0 12 0;">
                <Label text="Description"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <TextArea fx:id="taDescription" prefRowCount="4" wrapText="true"
                          promptText="Description détaillée"
                          style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 8; -fx-font-size: 13;"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="btnGenererImage" text="Régénérer"
                            onAction="#handleGenererImage"
                            style="-fx-background-color: #8D6E63; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 6 16;
                                   -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- ── Aperçu image ──────────────────────────────────── -->
            <VBox spacing="6" style="-fx-padding: 0 0 12 0;">
                <Label text="Aperçu de l'image générée :"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <VBox fx:id="vboxApercu" alignment="CENTER" spacing="8" prefHeight="160"
                      style="-fx-background-color: #f5f5f5; -fx-border-color: #8D6E63;
                             -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1;">
                    <ImageView fx:id="ivApercu" fitWidth="700" fitHeight="155"
                               preserveRatio="true" smooth="true" visible="false" managed="false"/>
                    <Label fx:id="lblApercuPlaceholder"
                           text="Remplissez la description puis cliquez sur Régénérer"
                           style="-fx-font-size: 12; -fx-text-fill: #b0a090;"
                           wrapText="true" alignment="CENTER" maxWidth="500"/>
                </VBox>
            </VBox>

            <!-- ── Date ──────────────────────────────────────────── -->
            <VBox spacing="4" style="-fx-padding: 0 0 12 0;">
                <Label text="Date"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <Label fx:id="lblDate"
                       style="-fx-background-color: #f5f5f5; -fx-border-color: #dcd5ce;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 10; -fx-font-size: 13; -fx-text-fill: #9a9a9a;"/>
            </VBox>

            <!-- ── Produit ────────────────────────────────────────── -->
            <VBox spacing="4" style="-fx-padding: 0 0 12 0;">
                <Label text="Produit"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <ComboBox fx:id="cbProduit" maxWidth="Infinity"
                          style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 6; -fx-font-size: 13;"/>
            </VBox>

            <!-- ── Bloc Estimation IA ─────────────────────────────── -->
            <VBox fx:id="vboxEstimation" spacing="10" visible="false" managed="false"
                  style="-fx-background-color: #E3F2FD;
                         -fx-border-color: #1565c0;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-border-width: 1.5; -fx-padding: 14 16;
                         -fx-margin: 0 0 12 0;">
                <VBox.margin><Insets bottom="12"/></VBox.margin>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Estimation IA du prix"
                           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1565c0;"
                           HBox.hgrow="ALWAYS"/>
                    <Button text="Estimer IA" onAction="#handleEstimerPrix"
                            style="-fx-background-color: #1565c0; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 8 18;
                                   -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="lblEstimDetail"
                       text="Cliquez sur Estimer IA pour obtenir une suggestion de prix"
                       style="-fx-font-size: 12; -fx-text-fill: #1a237e;"
                       wrapText="true"/>

                <Button fx:id="btnAppliquerPrix" text="Appliquer ce prix"
                        onAction="#handleAppliquerPrix"
                        visible="false" managed="false"
                        style="-fx-background-color: #2d7a58; -fx-text-fill: white;
                               -fx-background-radius: 20; -fx-padding: 8 20;
                               -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <!-- ── Prix proposé ───────────────────────────────────── -->
            <VBox spacing="4" style="-fx-padding: 0 0 12 0;">
                <Label text="Prix propose (TND)"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <TextField fx:id="tfPrix" promptText="Ex: 45.00"
                           style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10; -fx-font-size: 13;"/>
            </VBox>

            <!-- ── Téléphone ──────────────────────────────────────── -->
            <VBox spacing="4" style="-fx-padding: 0 0 16 0;">
                <Label text="Votre numero de telephone"
                       style="-fx-font-weight: bold; -fx-text-fill: #2f2430; -fx-font-size: 13;"/>
                <TextField fx:id="tfTelephone" promptText="+216XXXXXXXX"
                           style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10; -fx-font-size: 13;"/>
            </VBox>

            <!-- ── Artisans recommandés ───────────────────────────── -->
            <VBox fx:id="vboxArtisans" spacing="8" visible="false" managed="false"
                  style="-fx-background-color: #fffdf4;
                         -fx-border-color: #e8c97a;
                         -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-width: 1.5; -fx-padding: 20 20;">
                <VBox.margin><Insets bottom="20"/></VBox.margin>

                <Label text="Artisans recommandés"
                       style="-fx-font-size: 15; -fx-font-weight: 500; -fx-text-fill: #b07d1a; -fx-padding: 0 0 8 0;"/>

                <VBox fx:id="listeArtisans" spacing="8"/>
            </VBox>

            <!-- ── Boutons centrés ────────────────────────────────── -->
            <HBox spacing="16" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button text="Creer la proposition" onAction="#handleEnregistrer"
                        style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                               -fx-background-radius: 30; -fx-padding: 14 32;
                               -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: white; -fx-text-fill: #5D4037;
                               -fx-border-color: #dcd5ce; -fx-border-radius: 30;
                               -fx-background-radius: 30; -fx-border-width: 1;
                               -fx-padding: 14 28; -fx-font-size: 14; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>
