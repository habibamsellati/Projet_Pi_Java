<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="500.0" prefWidth="400.0" spacing="0" style="-fx-background-color: white;" 
      stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ChatbotController">
    
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #1a1a1a; -fx-padding: 20;">
        <StackPane>
            <Circle fill="#c4704b" radius="18" />
            <Label text="🎨" style="-fx-font-size: 18px;" />
        </StackPane>
        <VBox>
            <Label text="Concierge AfkArt" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" />
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Circle fill="#10b981" radius="4" />
                <Label text="En ligne" style="-fx-text-fill: #9e8e82; -fx-font-size: 11px;" />
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnClose" onAction="#handleClose" style="-fx-background-color: transparent; -fx-text-fill: #9e8e82; -fx-font-size: 18px; -fx-cursor: hand;" text="✕" />
    </HBox>

    <!-- Chat Area -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #fdfdfd;" VBox.vgrow="ALWAYS">
        <VBox fx:id="chatHistory" spacing="15" style="-fx-padding: 20;">
            <!-- Messages go here -->
        </VBox>
    </ScrollPane>

    <!-- Footer / Input -->
    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 0 0 20 20;">
        <TextField fx:id="txtMessage" onAction="#handleSendMessage" promptText="Posez votre question..." HBox.hgrow="ALWAYS" 
                   style="-fx-background-radius: 20; -fx-padding: 10 20; -fx-border-color: #f0f0f0; -fx-border-radius: 20; -fx-background-color: #fafafa;" />
        <Button onAction="#handleSendMessage" style="-fx-background-color: #c4704b; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 10; -fx-cursor: hand;" text="➤" />
    </HBox>
</VBox>
