<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" stylesheets="@/css/admin_style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AdminReservationsController">
    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

    <!-- Header Actions -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="tfSearch" promptText="Rechercher une réservation..." prefWidth="350" styleClass="search-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Actualiser" styleClass="btn-secondary" onAction="#loadData"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tvReservations" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colEventName" text="Événement" prefWidth="250"/>
            <TableColumn fx:id="colUser" text="Client" prefWidth="150"/>
            <TableColumn fx:id="colDate" text="Date Res." prefWidth="150"/>
            <TableColumn fx:id="colPlaces" text="Places" prefWidth="80"/>
            <TableColumn fx:id="colTotal" text="Total (DT)" prefWidth="100"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
