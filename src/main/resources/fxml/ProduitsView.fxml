<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="main-container"
            stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ProduitsController">
    <content>
        <VBox spacing="0" style="-fx-background-color: #F9F7F2;">

            <!-- En-tête catalogue -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-padding: 50 40 30 40; -fx-background-color: #F9F7F2;">

                <Label text="Catalogue de Revalorisation"
                       style="-fx-font-family: Georgia; -fx-font-size: 36; -fx-text-fill: #2f2430;"/>

                <Label text="PROPULSE PAR L'INTELLIGENCE ARTIFICIELLE AFKART"
                       style="-fx-font-size: 11; -fx-text-fill: #b0a090; -fx-font-weight: bold;"/>

                <Region prefWidth="60" prefHeight="2"
                        style="-fx-background-color: #8D6E63;"/>

                <Button text="+ Ajouter un Produit"
                        onAction="#handleAfficherFormulaire"
                        style="-fx-background-color: #2f2430; -fx-text-fill: white;
                               -fx-background-radius: 30; -fx-padding: 14 32;
                               -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Button>

                <!-- Barre recherche + filtres -->
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 16 0 0 0;">
                    <TextField fx:id="tfRecherche"
                               promptText="Rechercher..."
                               prefWidth="280"
                               style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                      -fx-border-radius: 20; -fx-background-radius: 20;
                                      -fx-padding: 9 16; -fx-font-size: 13;"/>
                    <ComboBox fx:id="cbFiltreEtat" prefWidth="160"
                              style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                     -fx-border-radius: 20; -fx-background-radius: 20;"/>
                    <ComboBox fx:id="cbTri" prefWidth="180"
                              style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                     -fx-border-radius: 20; -fx-background-radius: 20;"/>
                    <Button text="Rafraichir" onAction="#handleRafraichir"
                            style="-fx-background-color: #E0DDD5; -fx-text-fill: #5D4037;
                                   -fx-background-radius: 20; -fx-padding: 9 18; -fx-cursor: hand;"/>
                    <Button text="Retour" onAction="#handleRetour"
                            style="-fx-background-color: #E0DDD5; -fx-text-fill: #5D4037;
                                   -fx-background-radius: 20; -fx-padding: 9 18; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Message vide -->
            <Label fx:id="lblAucunProduit"
                   text="Aucun produit recyclable trouvé pour le moment."
                   style="-fx-text-fill: #8D6E63; -fx-font-style: italic; -fx-font-size: 14;">
                <VBox.margin><Insets left="40"/></VBox.margin>
            </Label>

            <!-- Grille produits -->
            <VBox fx:id="produitsContainer" spacing="32"
                  style="-fx-padding: 10 40 40 40;"/>

        </VBox>
    </content>
</ScrollPane>
