<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="article-card" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.CommandeCardController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="lblNumero" text="CMD-20260410-XXXXXX" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblDate" text="10/04/2026 12:00" style="-fx-text-fill: #8D6E63;"/>
    </HBox>

    <HBox spacing="18">
        <Label text="Statut :" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblStatut" text="en_attente"/>
        <Label text="Mode :" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblModePaiement" text="carte"/>
        <Label text="Client :" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblClient" text="Client #1"/>
    </HBox>

    <HBox spacing="18">
        <Label text="Total :" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblTotal" text="120.00 DT"/>
        <Label text="Téléphone :" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblTelephone" text="+21620123456"/>
    </HBox>

    <Label text="Adresse de livraison" style="-fx-font-weight: bold;"/>
    <Label fx:id="lblAdresse" text="12 Rue de Carthage, Tunis" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Modifier" styleClass="btn-modifier" onAction="#handleModifier"/>
        <Button fx:id="btnSupprimer" text="Supprimer" styleClass="btn-supprimer" onAction="#handleSupprimer"/>
    </HBox>
</VBox>

