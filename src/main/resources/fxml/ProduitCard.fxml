<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ProduitCardController"
      prefWidth="300"
      style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-border-color: #E8E0D8;
             -fx-border-radius: 16;
             -fx-border-width: 1;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.07), 10, 0, 0, 3);">

    <!-- Image avec badge état -->
    <StackPane>
        <ImageView fx:id="ivImage"
                   fitWidth="300" fitHeight="200"
                   preserveRatio="false" smooth="true">
        </ImageView>
        <!-- Badge état (coin haut droit) -->
        <Label fx:id="lblEtat" text="BON"
               style="-fx-background-color: white;
                      -fx-text-fill: #2f2430;
                      -fx-font-size: 11;
                      -fx-font-weight: bold;
                      -fx-background-radius: 20;
                      -fx-padding: 4 10;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 4, 0, 0, 1);"
               StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets top="10" right="10"/>
            </StackPane.margin>
        </Label>
    </StackPane>

    <!-- Contenu texte -->
    <VBox spacing="8" style="-fx-padding: 16 16 12 16;">

        <!-- Nom -->
        <Label fx:id="lblNom" text="Nom produit"
               style="-fx-font-size: 18;
                      -fx-font-family: 'Georgia';
                      -fx-font-weight: bold;
                      -fx-text-fill: #2f2430;"/>

        <!-- Description courte -->
        <Label fx:id="lblDescription" text="Description..."
               wrapText="true"
               style="-fx-font-size: 12;
                      -fx-text-fill: #7a6a5a;
                      -fx-line-spacing: 2;"/>

        <!-- Séparateur léger -->
        <Region prefHeight="4"/>

        <!-- Localisation + Quantité -->
        <HBox spacing="24">
            <VBox spacing="2">
                <Label text="LOCALISATION"
                       style="-fx-font-size: 10;
                              -fx-font-weight: bold;
                              -fx-text-fill: #b0a090;"/>
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="📍"
                           style="-fx-font-size: 12;"/>
                    <Label fx:id="lblOrigine" text="Tunis"
                           style="-fx-font-size: 13;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2f2430;"/>
                </HBox>
            </VBox>
            <VBox spacing="2">
                <Label text="QUANTITÉ"
                       style="-fx-font-size: 10;
                              -fx-font-weight: bold;
                              -fx-text-fill: #b0a090;"/>
                <Label fx:id="lblQuantite" text="3 Unités"
                       style="-fx-font-size: 13;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2f2430;"/>
            </VBox>
        </HBox>

        <!-- Boutons Détails + Modifier -->
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
            <Button fx:id="btnDetails" text="Détails"
                    onAction="#handleModifier"
                    style="-fx-background-color: white;
                           -fx-text-fill: #2f2430;
                           -fx-border-color: #c8b8a8;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-border-width: 1.5;
                           -fx-padding: 8 28;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"/>
            <Button fx:id="btnModifier" text="✎"
                    onAction="#handleModifier"
                    style="-fx-background-color: white;
                           -fx-text-fill: #7a6a5a;
                           -fx-border-color: #c8b8a8;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-border-width: 1.5;
                           -fx-padding: 8 12;
                           -fx-font-size: 14;
                           -fx-cursor: hand;"/>
            <Button fx:id="btnSupprimer" text="🗑"
                    onAction="#handleSupprimer"
                    style="-fx-background-color: white;
                           -fx-text-fill: #c0392b;
                           -fx-border-color: #f5c6c6;
                           -fx-border-radius: 20;
                           -fx-background-radius: 20;
                           -fx-border-width: 1.5;
                           -fx-padding: 8 12;
                           -fx-font-size: 14;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</VBox>
