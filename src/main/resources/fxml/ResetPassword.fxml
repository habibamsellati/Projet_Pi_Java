<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ResetPasswordController"
            stylesheets="@/css/login.css"
            style="-fx-background-color: #f0ebe4;">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="0">
            <Label text="AfkArt" styleClass="logo-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour" styleClass="btn-connexion" onAction="#handleRetourLogin"/>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <VBox spacing="14" alignment="CENTER" styleClass="form-card"
                  style="-fx-padding: 36 40; -fx-max-width: 500; -fx-min-width: 430;">
                <Label text="Réinitialiser le mot de passe" styleClass="form-title"/>
                <Label text="Saisissez l'email, le code reçu et votre nouveau mot de passe" styleClass="form-subtitle" wrapText="true"/>

                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="tfEmail" promptText="Entrez votre email" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="Code" styleClass="field-label"/>
                    <TextField fx:id="tfCode" promptText="Code à 6 chiffres" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="Nouveau mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="pfNewPassword" promptText="Nouveau mot de passe" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="pfConfirmPassword" promptText="Confirmez le mot de passe" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>

                <Label fx:id="lblMessage" text="" styleClass="error-label" wrapText="true" maxWidth="Infinity"/>

                <Button text="Mettre à jour le mot de passe" onAction="#handleResetPassword" styleClass="btn-login" maxWidth="Infinity"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

