<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="article-card" stylesheets="@/css/style.css" prefWidth="390" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.ClientArticleCardController">
    <ImageView fx:id="ivImage" fitWidth="390" fitHeight="190" preserveRatio="false" smooth="true"/>

    <VBox spacing="8" style="-fx-padding: 14;">
        <Label fx:id="lblDate" text="10 APR 2026" style="-fx-text-fill: #B7AFA0; -fx-font-size: 18; -fx-font-weight: bold;"/>
        <Label fx:id="lblTitre" text="Titre" wrapText="true" style="-fx-font-size: 40; -fx-font-family: 'Serif';"/>
        <Label fx:id="lblContenu" text="Description" wrapText="true" style="-fx-font-size: 28;"/>
        <Label fx:id="lblPrix" text="500.00 DT" style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #8D5E3C;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Lire la suite" onAction="#handleLireSuite" styleClass="btn-publier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnAjouterPanier" text="Ajouter au panier" onAction="#handleAjouterPanier"
                    style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 22; -fx-padding: 10 18;"/>
        </HBox>
    </VBox>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>

