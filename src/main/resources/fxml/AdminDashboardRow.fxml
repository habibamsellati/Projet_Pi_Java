<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="0" alignment="CENTER_LEFT"
      style="-fx-padding: 14 25; -fx-background-color: white; -fx-border-color: transparent transparent #ede5de transparent;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <Label fx:id="lblId" text="#0" prefWidth="80" minWidth="-Infinity"
           style="-fx-font-weight: bold; -fx-text-fill: #2d2d2d;"/>

    <Label fx:id="lblEventTitle" text="—" prefWidth="300" minWidth="-Infinity"
           style="-fx-font-weight: bold; -fx-text-fill: #2d2d2d;"/>

    <Label fx:id="lblDate" text="—" prefWidth="200" minWidth="-Infinity"
           style="-fx-text-fill: #6b5b4f;"/>

    <!-- Badge statut -->
    <StackPane fx:id="badgeContainer" prefWidth="150" minWidth="-Infinity"
               style="-fx-alignment: CENTER_LEFT;">
        <Label fx:id="lblStatus" text="—"
               style="-fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11; -fx-font-weight: bold;"/>
    </StackPane>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- Actions -->
    <HBox spacing="8" alignment="CENTER_RIGHT" prefWidth="150" minWidth="-Infinity">
        <Button fx:id="btnDelete" text="🗑"
                style="-fx-background-color: transparent; -fx-text-fill: #c62828; -fx-cursor: hand; -fx-font-size: 14;"/>
    </HBox>

</HBox>

