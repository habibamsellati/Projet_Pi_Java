<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox fx:id="rowRoot" alignment="CENTER_LEFT" spacing="0" styleClass="dashboard-row"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets left="25" right="25" top="14" bottom="14"/>
    </padding>

    <!-- ID -->
    <Label fx:id="lblId" text="#83" prefWidth="80" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-text-fill: #2d2d2d; -fx-font-size: 13px;"/>

    <!-- Event Info -->
    <Label fx:id="lblEventTitle" text="Nom de l'Événement" prefWidth="300" minWidth="-Infinity" style="-fx-text-fill: #2d2d2d; -fx-font-size: 13px;"/>

    <!-- Date -->
    <Label fx:id="lblDate" text="12/04/2026 14:30" prefWidth="200" minWidth="-Infinity" style="-fx-text-fill: #8b5e4a; -fx-font-size: 12px; -fx-font-weight: bold;"/>

    <!-- Status Badge -->
    <StackPane fx:id="badgeContainer" minWidth="-Infinity" style="-fx-padding: 5 10; -fx-background-radius: 20;">
        <Label fx:id="lblStatus" text="CONFIRMÉ" minWidth="-Infinity" style="-fx-font-size: 10px; -fx-font-weight: 900;"/>
    </StackPane>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- Actions -->
    <HBox spacing="10" alignment="CENTER_RIGHT" prefWidth="150" minWidth="-Infinity">
        <Button text="👁" style="-fx-background-color: transparent; -fx-text-fill: #8b5e4a; -fx-cursor: hand; -fx-font-size: 14px;"/>
        <Button text="✏️" style="-fx-background-color: transparent; -fx-text-fill: #c4956a; -fx-cursor: hand; -fx-font-size: 14px;"/>
        <Button text="🗑" style="-fx-background-color: transparent; -fx-text-fill: #c62828; -fx-cursor: hand; -fx-font-size: 14px;"/>
    </HBox>
</HBox>
