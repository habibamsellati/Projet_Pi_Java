<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PropositionCardController"
      prefWidth="300"
      style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-border-color: #E8E0D8;
             -fx-border-radius: 16;
             -fx-border-width: 1;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.07), 10, 0, 0, 3);">

    <!-- Image -->
    <StackPane>
        <ImageView fx:id="ivImage"
                   fitWidth="300" fitHeight="200"
                   preserveRatio="false" smooth="true"/>
    </StackPane>

    <!-- Contenu -->
    <VBox spacing="8" style="-fx-padding: 16 16 14 16;">

        <!-- Titre -->
        <Label fx:id="lblTitre"
               style="-fx-font-family: Georgia; -fx-font-size: 18;
                      -fx-text-fill: #2f2430; -fx-font-weight: bold;"
               wrapText="true"/>

        <!-- Description courte -->
        <Label fx:id="lblDescription"
               style="-fx-font-size: 12; -fx-text-fill: #7a6a5a; -fx-line-spacing: 2;"
               wrapText="true"/>

        <!-- Prix badge -->
        <Label fx:id="lblPrix"
               style="-fx-background-color: #fff3e0;
                      -fx-text-fill: #e65100;
                      -fx-background-radius: 20;
                      -fx-padding: 4 12;
                      -fx-font-size: 12;
                      -fx-font-weight: bold;"/>

        <Region prefHeight="4"/>

        <!-- Utilisateur + bouton VOIR -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="lblAvatar"
                   style="-fx-background-color: #8D6E63;
                          -fx-text-fill: white;
                          -fx-background-radius: 20;
                          -fx-min-width: 32; -fx-min-height: 32;
                          -fx-max-width: 32; -fx-max-height: 32;
                          -fx-alignment: CENTER;
                          -fx-font-weight: bold;
                          -fx-font-size: 13;"/>
            <Label fx:id="lblUser"
                   style="-fx-font-size: 13; -fx-text-fill: #4a3b2b; -fx-font-weight: bold;"
                   HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoir" text="VOIR →"
                    onAction="#handleModifier"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8D6E63;
                           -fx-font-size: 12;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;
                           -fx-border-color: transparent;"/>
        </HBox>

        <!-- Boutons modifier / supprimer -->
        <HBox fx:id="boxActions" spacing="8" alignment="CENTER_LEFT"
              style="-fx-padding: 4 0 0 0;">
            <Button fx:id="btnModifier" text="Modifier"
                    onAction="#handleModifier"
                    style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                           -fx-background-radius: 20; -fx-padding: 7 18;
                           -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button fx:id="btnSupprimer" text="Supprimer"
                    onAction="#handleSupprimer"
                    style="-fx-background-color: transparent; -fx-text-fill: #c0392b;
                           -fx-font-size: 12; -fx-cursor: hand;
                           -fx-border-color: transparent;"/>
        </HBox>

        <!-- Boutons statut : Accepter / Refuser / Terminer -->
        <HBox fx:id="boxStatut" spacing="6" alignment="CENTER_LEFT"
              style="-fx-padding: 2 0 0 0;">
            <Button fx:id="btnAccepter" text="Accepter"
                    onAction="#handleAccepter"
                    style="-fx-background-color: #1e8e3e; -fx-text-fill: white;
                           -fx-background-radius: 14; -fx-padding: 5 14;
                           -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button fx:id="btnRefuser" text="Refuser"
                    onAction="#handleRefuser"
                    style="-fx-background-color: #d93025; -fx-text-fill: white;
                           -fx-background-radius: 14; -fx-padding: 5 14;
                           -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button fx:id="btnTerminer" text="Terminer"
                    onAction="#handleTerminer"
                    style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                           -fx-background-radius: 14; -fx-padding: 5 14;
                           -fx-font-size: 11; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</VBox>
