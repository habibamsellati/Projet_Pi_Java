<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Vue contenu seul — chargée dans le panneau central du dashboard admin -->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.AdminPropositionsController"
      stylesheets="@/css/admin-dashboard.css"
      style="-fx-background-color: #f5f0eb;">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <VBox spacing="16" style="-fx-padding: 24 28;">

            <!-- Titre section -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Gestion des Propositions"
                           style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#2f2430;"/>
                    <Label text="Espace d'administration AfkArt"
                           style="-fx-font-size:12;-fx-text-fill:#8a7060;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox style="-fx-background-color:white;-fx-border-color:#dcd5ce;
                             -fx-border-radius:20;-fx-background-radius:20;-fx-padding:8 14;"
                      spacing="8" alignment="CENTER_LEFT">
                    <Label text="🔍" style="-fx-text-fill:#a09890;-fx-font-size:13;"/>
                    <TextField fx:id="tfRechercheTop" promptText="Rechercher..."
                               style="-fx-background-color:transparent;-fx-border-color:transparent;
                                      -fx-font-size:13;" prefWidth="200"/>
                </HBox>
            </HBox>

            <!-- Tableau -->
            <VBox style="-fx-background-color:white;-fx-background-radius:12;
                         -fx-border-color:#e8e0d8;-fx-border-radius:12;-fx-border-width:1;">

                <GridPane style="-fx-background-color:#2f2430;
                                 -fx-background-radius:12 12 0 0;-fx-padding:12 16;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="30"/>
                        <ColumnConstraints percentWidth="13"/>
                        <ColumnConstraints percentWidth="17"/>
                        <ColumnConstraints percentWidth="15"/>
                    </columnConstraints>
                    <Label text="TITRE"       style="-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;" GridPane.columnIndex="0"/>
                    <Label text="DESCRIPTION" style="-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;" GridPane.columnIndex="1"/>
                    <Label text="DATE"        style="-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;" GridPane.columnIndex="2"/>
                    <Label text="PRODUIT LIÉ" style="-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;" GridPane.columnIndex="3"/>
                    <Label text="ACTIONS"     style="-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;" GridPane.columnIndex="4"/>
                </GridPane>

                <VBox fx:id="tableContainer" spacing="0"/>
                <Label fx:id="lblVide" text="Aucune proposition trouvée."
                       style="-fx-text-fill:#9a9a9a;-fx-font-style:italic;-fx-font-size:13;-fx-padding:20;"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Actions rapides -->
            <VBox style="-fx-background-color:white;-fx-background-radius:12;
                         -fx-border-color:#e8e0d8;-fx-border-radius:12;
                         -fx-border-width:1;-fx-padding:18 20;">
                <Label text="Actions rapides"
                       style="-fx-font-size:15;-fx-font-weight:bold;-fx-text-fill:#2f2430;-fx-padding:0 0 12 0;"/>
                <HBox spacing="12">
                    <Button text="📅  Tri par date"   onAction="#handleTriDate"
                            style="-fx-background-color:#f9f7f4;-fx-text-fill:#5D4037;-fx-border-color:#dcd5ce;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:16 20;-fx-font-size:13;-fx-cursor:hand;" prefWidth="180" prefHeight="70"/>
                    <Button text="↺  Annuler"          onAction="#handleReinitialiser"
                            style="-fx-background-color:#f9f7f4;-fx-text-fill:#5D4037;-fx-border-color:#dcd5ce;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:16 20;-fx-font-size:13;-fx-cursor:hand;" prefWidth="180" prefHeight="70"/>
                    <Button text="📊  Statistiques"   onAction="#handleStatistiques"
                            style="-fx-background-color:#f9f7f4;-fx-text-fill:#5D4037;-fx-border-color:#dcd5ce;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:16 20;-fx-font-size:13;-fx-cursor:hand;" prefWidth="180" prefHeight="70"/>
                    <Button text="📄  Exporter PDF"   onAction="#handleExporterPdf"
                            style="-fx-background-color:#f9f7f4;-fx-text-fill:#5D4037;-fx-border-color:#dcd5ce;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:16 20;-fx-font-size:13;-fx-cursor:hand;" prefWidth="180" prefHeight="70"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
