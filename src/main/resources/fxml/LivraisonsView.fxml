<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.MesLivraisonsController"
      spacing="0"
      style="-fx-background-color:#f5f0e8;">

    <!-- ── Topbar ─────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-padding:20 28 16 28;">
        <VBox spacing="3">
            <Label text="Gestion des Livraisons"
                   style="-fx-font-size:26;-fx-font-family:Georgia;-fx-font-weight:bold;-fx-text-fill:#2f2430;"/>
            <Label text="Liste et gestion des livraisons"
                   style="-fx-font-size:12;-fx-text-fill:#8a7060;-fx-font-style:italic;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Recherche -->
        <HBox style="-fx-background-color:rgba(255,255,255,0.9);-fx-background-radius:22;
                     -fx-border-color:#e0d5c8;-fx-border-radius:22;-fx-padding:8 16;"
              spacing="8" alignment="CENTER_LEFT">
            <Label text="—" style="-fx-text-fill:#b0a090;-fx-font-size:12;"/>
            <TextField fx:id="tfRecherche" promptText="Rechercher une livraison..."
                       style="-fx-background-color:transparent;-fx-border-color:transparent;
                              -fx-font-size:13;" prefWidth="200"/>
        </HBox>
        <!-- Boutons -->
        <Button text="Exporter en PDF" onAction="#handleExportPdf"
                style="-fx-background-color:#4a3020;-fx-text-fill:white;
                       -fx-background-radius:20;-fx-padding:10 20;
                       -fx-font-size:13;-fx-font-weight:bold;-fx-cursor:hand;"/>
        <Button fx:id="btnAjouter" text="+ Ajouter livraison" onAction="#handleAjouter"
                style="-fx-background-color:#c8763a;-fx-text-fill:white;
                       -fx-background-radius:20;-fx-padding:10 20;
                       -fx-font-size:13;-fx-font-weight:bold;-fx-cursor:hand;"/>
    </HBox>

    <!-- ── Stat cards ─────────────────────────────────────── -->
    <HBox spacing="16" style="-fx-padding:0 28 20 28;">
        <!-- Total -->
        <VBox spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color:#5a3050;-fx-background-radius:16;-fx-padding:20 24;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="🚚" style="-fx-font-size:16;"/>
                <Label text="Total Livraisons"
                       style="-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:13;"/>
            </HBox>
            <Label fx:id="lblTotal" text="0"
                   style="-fx-font-size:38;-fx-font-weight:bold;-fx-text-fill:white;"/>
            <Label text="livraisons enregistrées"
                   style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
        </VBox>
        <!-- Livrées -->
        <VBox spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color:#1e5c3a;-fx-background-radius:16;-fx-padding:20 24;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="✅" style="-fx-font-size:16;"/>
                <Label text="Livrées"
                       style="-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:13;"/>
            </HBox>
            <Label fx:id="lblLivrees" text="0"
                   style="-fx-font-size:38;-fx-font-weight:bold;-fx-text-fill:white;"/>
            <Label text="livraisons complétées"
                   style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
        </VBox>
        <!-- En attente -->
        <VBox spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color:#7a4010;-fx-background-radius:16;-fx-padding:20 24;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="⏳" style="-fx-font-size:16;"/>
                <Label text="En attente"
                       style="-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:13;"/>
            </HBox>
            <Label fx:id="lblEnAttente" text="0"
                   style="-fx-font-size:38;-fx-font-weight:bold;-fx-text-fill:white;"/>
            <Label text="en cours de traitement"
                   style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
        </VBox>
    </HBox>

    <!-- ── En-tête tableau ────────────────────────────────── -->
    <HBox style="-fx-padding:10 28;-fx-background-color:transparent;">
        <Label text="DATE"    style="-fx-font-weight:bold;-fx-text-fill:#7a6a5a;-fx-font-size:12;" prefWidth="200"/>
        <Label text="ADRESSE" style="-fx-font-weight:bold;-fx-text-fill:#7a6a5a;-fx-font-size:12;" HBox.hgrow="ALWAYS"/>
        <Label text="STATUT"  style="-fx-font-weight:bold;-fx-text-fill:#7a6a5a;-fx-font-size:12;" prefWidth="150"/>
        <Label text="ACTIONS" style="-fx-font-weight:bold;-fx-text-fill:#7a6a5a;-fx-font-size:12;" prefWidth="200"/>
    </HBox>

    <!-- ── Lignes dynamiques ──────────────────────────────── -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent;-fx-background:transparent;
                       -fx-border-color:transparent;-fx-padding:0 28;">
        <VBox fx:id="vboxLivraisons" spacing="0"/>
    </ScrollPane>

</VBox>
