<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.example.controllers.CommandesValideesController"
        stylesheets="@/css/admin-dashboard.css"
        prefWidth="1200" prefHeight="780">

    <left>
        <VBox styleClass="sidebar" spacing="1">
            <HBox styleClass="logo-box">
                <Label text="🎨" styleClass="logo-icon"/>
                <Label text="afk'art" styleClass="logo-text"/>
            </HBox>
            <Label text="MENU PRINCIPAL" styleClass="nav-section-lbl"/>
            <Button text="⊞  Dashboard"            styleClass="nav-btn" maxWidth="Infinity" onAction="#handleNavDashboard"/>
            <Button text="📰  Articles"             styleClass="nav-btn" maxWidth="Infinity" onAction="#handleNavArticles"/>
            <Button text="⚠  Réclamations"         styleClass="nav-btn" maxWidth="Infinity" onAction="#handleNavReclamations"/>
            <Button text="🛒  Commandes"            styleClass="nav-btn" maxWidth="Infinity" onAction="#handleNavCommandes"/>
            <Label text="VUE VALIDÉES" styleClass="nav-sub-lbl"/>
            <Button text="✅  Commandes validées"   styleClass="nav-btn,nav-btn-active" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Déconnexion"
                    styleClass="nav-btn,nav-logout" maxWidth="Infinity"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox styleClass="topbar">
                <VBox spacing="2">
                    <Label text="Commandes Validées" styleClass="topbar-title"/>
                    <Label text="Toutes les commandes confirmées — triées par date décroissante" styleClass="topbar-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="user-pill">
                    <Label fx:id="lblAvatar" text="AD" styleClass="avatar-lbl"/>
                    <VBox spacing="1">
                        <Label fx:id="lblNomAdmin" text="Admin" styleClass="user-name-lbl"/>
                        <Label text="Super Admin" styleClass="user-role-lbl"/>
                    </VBox>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox styleClass="content-area" spacing="20">
                    <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-padding: 18; -fx-spacing: 14;
                                 -fx-border-color: #e8e0d8; -fx-border-radius: 14; -fx-border-width: 1;
                                 -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.06),10,0,0,3);">

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="✅  Commandes confirmées"
                                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #22a050;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblCount"
                                   text="0 commande(s)"
                                   style="-fx-font-size: 13; -fx-text-fill: #7a7570;"/>
                            <Button text="📄 Exporter PDF"
                                    onAction="#handleExportPdf"
                                    style="-fx-background-color: #4a1e2e; -fx-text-fill: white;
                                           -fx-background-radius: 8; -fx-padding: 8 18; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- En-tête -->
                        <HBox spacing="0"
                              style="-fx-background-color: #f5f0eb; -fx-background-radius: 8;
                                     -fx-padding: 10 16;">
                            <Label text="N° Commande"
                                   style="-fx-font-weight: bold; -fx-text-fill: #7a7570; -fx-font-size:12;"
                                   prefWidth="200"/>
                            <Label text="Date"
                                   style="-fx-font-weight: bold; -fx-text-fill: #7a7570; -fx-font-size:12;"
                                   prefWidth="140"/>
                            <Label text="Client"
                                   style="-fx-font-weight: bold; -fx-text-fill: #7a7570; -fx-font-size:12;"
                                   prefWidth="180"/>
                            <Label text="Total"
                                   style="-fx-font-weight: bold; -fx-text-fill: #7a7570; -fx-font-size:12;"
                                   prefWidth="120"/>
                            <Label text="Adresse de livraison"
                                   style="-fx-font-weight: bold; -fx-text-fill: #7a7570; -fx-font-size:12;"
                                   HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <VBox fx:id="valideesContainer" spacing="2"/>

                        <Label fx:id="lblAucune"
                               text="Aucune commande validée pour le moment."
                               visible="false"
                               style="-fx-text-fill: #8D6E63; -fx-font-size: 14; -fx-padding: 16 0;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>

