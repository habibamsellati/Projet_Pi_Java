<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-container" stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.HistoriqueCommandesController">

    <!-- ── En-tête ── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-padding: 18 28; -fx-background-color: white;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
            <Button text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: #E0DDD5; -fx-text-fill: #5D4037;
                           -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Label text="⏱ Historique des commandes" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCount" text=""
                   style="-fx-font-size: 14; -fx-text-fill: #A1887F;"/>
        </HBox>
    </top>

    <!-- ── Zone principale ── -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="vbCommandes" spacing="20"
                      style="-fx-padding: 30 36;">

                    <!-- État vide -->
                    <VBox fx:id="vboxEmpty" alignment="CENTER" spacing="18"
                          style="-fx-padding: 60;" visible="false" managed="false">
                        <Label text="📭" style="-fx-font-size: 64;"/>
                        <Label text="Aucune commande pour l'instant"
                               style="-fx-font-size: 22; -fx-font-weight: bold;
                                      -fx-text-fill: #8D6E63; -fx-font-family: 'Serif';"/>
                        <Label text="Vos commandes passées apparaîtront ici."
                               style="-fx-font-size: 14; -fx-text-fill: #A1887F;"/>
                        <Button text="Voir les articles" onAction="#handleVoirArticles"
                                style="-fx-background-color: #8D6E63; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 22;
                                       -fx-padding: 12 32; -fx-cursor: hand;"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>

