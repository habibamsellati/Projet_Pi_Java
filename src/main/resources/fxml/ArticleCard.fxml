<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="article-card" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.ArticleCardController">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <ImageView fx:id="ivImage" fitHeight="170" fitWidth="520" preserveRatio="false" smooth="true"/>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="lblDate" text="Date" style="-fx-font-size: 12; -fx-text-fill: #8D6E63;"/>
        <Label fx:id="lblAuteur" text="Artisan" style="-fx-font-size: 12; -fx-text-fill: #8D6E63;"/>
    </HBox>

    <Label fx:id="lblTitre" text="Titre" style="-fx-font-size: 20; -fx-font-weight: bold;" wrapText="true"/>
    <Label fx:id="lblContenu" text="Contenu" wrapText="true"/>
    <Label fx:id="lblPrix" text="0.00 DT" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #5D4037;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Lire suite" onAction="#handleLireSuite"/>
        <Button fx:id="btnModifier" text="Modifier" styleClass="btn-modifier" onAction="#handleModifier"/>
        <Button text="Supprimer" styleClass="btn-supprimer" onAction="#handleSupprimer"/>
    </HBox>
</VBox>

