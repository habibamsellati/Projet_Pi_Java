<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.CalendrierPropositionsController"
      styleClass="main-container"
      stylesheets="@/css/style.css"
      style="-fx-background-color: #F9F7F2; -fx-padding: 24;">

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 20 0;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Calendrier des Propositions"
                   style="-fx-font-family: Georgia; -fx-font-size: 24; -fx-text-fill: #2f2430;"/>
            <Label fx:id="lblSousTitre" text="Visualisez vos propositions par date"
                   style="-fx-font-size: 13; -fx-text-fill: #8a7060;"/>
        </VBox>
        <Button text="Retour" onAction="#handleRetour"
                style="-fx-background-color: #E0DDD5; -fx-text-fill: #5D4037;
                       -fx-background-radius: 20; -fx-padding: 9 18; -fx-cursor: hand;"/>
    </HBox>

    <!-- Navigation mois -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 16 0;">
        <Button text="◀" onAction="#handleMoisPrecedent"
                style="-fx-background-color: white; -fx-text-fill: #5D4037;
                       -fx-border-color: #dcd5ce; -fx-border-radius: 20; -fx-background-radius: 20;
                       -fx-padding: 8 16; -fx-font-size: 14; -fx-cursor: hand;"/>
        <Label fx:id="lblMoisAnnee" text="Mai 2026"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2f2430;
                      -fx-min-width: 180; -fx-alignment: CENTER;"/>
        <Button text="▶" onAction="#handleMoisSuivant"
                style="-fx-background-color: white; -fx-text-fill: #5D4037;
                       -fx-border-color: #dcd5ce; -fx-border-radius: 20; -fx-background-radius: 20;
                       -fx-padding: 8 16; -fx-font-size: 14; -fx-cursor: hand;"/>
        <Button text="Aujourd'hui" onAction="#handleAujourdhui"
                style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                       -fx-background-radius: 20; -fx-padding: 8 16; -fx-cursor: hand;"/>
    </HBox>

    <!-- Légende statuts -->
    <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
        <Label text="● En attente"  style="-fx-text-fill: #F5A623; -fx-font-size: 12; -fx-font-weight: bold;"/>
        <Label text="● Acceptée"    style="-fx-text-fill: #1e8e3e; -fx-font-size: 12; -fx-font-weight: bold;"/>
        <Label text="● Refusée"     style="-fx-text-fill: #d93025; -fx-font-size: 12; -fx-font-weight: bold;"/>
        <Label text="● Terminée"    style="-fx-text-fill: #7a5c3a; -fx-font-size: 12; -fx-font-weight: bold;"/>
        <Label text="● En révision" style="-fx-text-fill: #1565c0; -fx-font-size: 12; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Grille calendrier -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                 -fx-border-color: #E8E0D8; -fx-border-radius: 12; -fx-border-width: 1;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2);"
          VBox.vgrow="ALWAYS">

        <!-- Jours de la semaine -->
        <GridPane fx:id="gridJours" style="-fx-background-color: #f5f0ea; -fx-padding: 8 0;">
        </GridPane>

        <!-- Grille des jours -->
        <GridPane fx:id="gridCalendrier" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
        </GridPane>
    </VBox>

    <!-- Détail proposition sélectionnée -->
    <VBox fx:id="vboxDetail" spacing="8" visible="false" managed="false"
          style="-fx-background-color: white; -fx-background-radius: 10;
                 -fx-border-color: #8D6E63; -fx-border-radius: 10; -fx-border-width: 1.5;
                 -fx-padding: 14 16; -fx-margin: 12 0 0 0;">
        <VBox.margin><Insets top="12"/></VBox.margin>
        <Label text="Détail de la proposition"
               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #7a5c3a;"/>
        <Label fx:id="lblDetailTitre"    style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2f2430;"/>
        <Label fx:id="lblDetailProduit"  style="-fx-font-size: 13; -fx-text-fill: #5D4037;"/>
        <Label fx:id="lblDetailStatut"   style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <Label fx:id="lblDetailPrix"     style="-fx-font-size: 13; -fx-text-fill: #5D4037;"/>
        <Label fx:id="lblDetailDate"     style="-fx-font-size: 12; -fx-text-fill: #9a9a9a;"/>
    </VBox>

</VBox>
