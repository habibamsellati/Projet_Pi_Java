<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="25" alignment="TOP_CENTER" stylesheets="@/css/admin_style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AdminController">
    
    <!-- TOP STATS (SPECIFIC TO ORDERS) -->
    <HBox spacing="30" alignment="CENTER">
        <VBox spacing="5" prefWidth="200" styleClass="stat-card" alignment="CENTER">
            <Label fx:id="lblStatTotal" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Total commandes" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
        <VBox spacing="5" prefWidth="200" styleClass="stat-card" alignment="CENTER">
            <Label fx:id="lblStatConfirmed" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
            <Label text="Confirmées" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
        <VBox spacing="5" prefWidth="200" styleClass="stat-card" alignment="CENTER">
            <Label fx:id="lblStatPending" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
            <Label text="En attente" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
        <VBox spacing="5" prefWidth="200" styleClass="stat-card" alignment="CENTER">
            <Label fx:id="lblStatRevenue" text="0.00 DT" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6366f1;"/>
            <Label text="Chiffre d'affaires" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
        </VBox>
    </HBox>

    <!-- CONTENT AREA -->
    <VBox spacing="20" VBox.vgrow="ALWAYS" styleClass="stat-card">
        
        <!-- TOOLBAR TABLE -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Liste des commandes" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="tfSearch" prefWidth="300" promptText="Rechercher par numéro ou client..." style="-fx-background-color: #f8f9fa; -fx-background-radius: 5;"/>
            <ComboBox fx:id="cbFilterStatut" prefWidth="150" promptText="Filtrer par statut"/>
            <Button text="Exporter PDF" style="-fx-background-color: #6d4c41; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 12px;"/>
        </HBox>

        <!-- TABLE -->
        <TableView fx:id="tvCommandes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="150" text="N° Commande" />
                <TableColumn fx:id="colDate" prefWidth="150" text="Date" />
                <TableColumn fx:id="colClient" prefWidth="120" text="ID Client" />
                <TableColumn fx:id="colStatut" prefWidth="130" text="Statut" />
                <TableColumn fx:id="colTotal" prefWidth="110" text="Total" />
                <TableColumn fx:id="colAdresse" prefWidth="180" text="Adresse" />
                <TableColumn fx:id="colActions" prefWidth="120" text="Actions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>

</VBox>
