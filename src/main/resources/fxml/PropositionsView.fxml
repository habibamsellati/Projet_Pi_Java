<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="main-container"
            stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.PropositionsController">
    <content>
        <VBox spacing="0" style="-fx-background-color: #F9F7F2;">

            <!-- ── Hero header ─────────────────────────────────── -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-padding: 60 40 40 40; -fx-background-color: #F9F7F2;">

                <Label text="INNOVER PAR LE RECYCLAGE"
                       style="-fx-font-size: 11; -fx-font-weight: bold;
                              -fx-text-fill: #8D6E63; -fx-letter-spacing: 2;"/>

                <Label text="Propositions de Transformation"
                       style="-fx-font-family: Georgia; -fx-font-size: 36;
                              -fx-text-fill: #2f2430;"/>

                <Label text="Explorez les visions artistiques pour donner une seconde vie aux matériaux collectés."
                       style="-fx-font-size: 13; -fx-text-fill: #8a7060;"
                       wrapText="true" alignment="CENTER" maxWidth="500"/>

                <Button text="Proposer une idée"
                        onAction="#handleAfficherFormulaire"
                        style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                               -fx-background-radius: 30; -fx-padding: 14 32;
                               -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Button>

                <!-- Bouton Calendrier (artisan seulement) -->
                <Button fx:id="btnCalendrier"
                        text="📅 Mes Propositions sur le Calendrier"
                        onAction="#handleToggleCalendrier"
                        visible="false" managed="false"
                        style="-fx-background-color: #4a3020; -fx-text-fill: white;
                               -fx-background-radius: 30; -fx-padding: 12 28;
                               -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <!-- Calendrier intégré (caché par défaut) -->
                <VBox fx:id="vboxCalendrier" visible="false" managed="false"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #e8e0d8; -fx-border-radius: 14;
                             -fx-border-width: 1; -fx-padding: 16;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 3);
                             -fx-max-width: 620;">

                    <!-- Navigation mois -->
                    <HBox alignment="CENTER" spacing="16" style="-fx-padding: 0 0 12 0;">
                        <Button fx:id="btnCalPrecedent" text="❮"
                                onAction="#handleCalMoisPrecedent"
                                style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-padding: 6 12;
                                       -fx-font-size: 13; -fx-cursor: hand;"/>
                        <Label fx:id="lblCalMois" text="mai 2026"
                               style="-fx-font-family: Georgia; -fx-font-size: 16;
                                      -fx-text-fill: #2f2430; -fx-min-width: 140;
                                      -fx-alignment: CENTER;"/>
                        <Button fx:id="btnCalSuivant" text="❯"
                                onAction="#handleCalMoisSuivant"
                                style="-fx-background-color: #7a5c3a; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-padding: 6 12;
                                       -fx-font-size: 13; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Grille calendrier -->
                    <GridPane fx:id="gridCalendrier" hgap="2" vgap="2"
                              style="-fx-background-color: #f5f0ea; -fx-background-radius: 10;
                                     -fx-padding: 8;"/>

                    <!-- Légende -->
                    <HBox spacing="12" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                        <Label text="● En attente"   style="-fx-text-fill: #F5A623; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label text="● Acceptée"     style="-fx-text-fill: #1e8e3e; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label text="● Refusée"      style="-fx-text-fill: #d93025; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label text="● Terminée"     style="-fx-text-fill: #7a5c3a; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Filtres -->
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 12 0 0 0;">
                    <TextField fx:id="tfRecherche" promptText="Rechercher..."
                               prefWidth="260"
                               style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                      -fx-border-radius: 20; -fx-background-radius: 20;
                                      -fx-padding: 9 16; -fx-font-size: 13;"/>
                    <ComboBox fx:id="cbFiltreStatut" prefWidth="160"
                              style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                     -fx-border-radius: 20; -fx-background-radius: 20;"/>
                    <ComboBox fx:id="cbFiltreProduit" prefWidth="180"
                              style="-fx-background-color: white; -fx-border-color: #dcd5ce;
                                     -fx-border-radius: 20; -fx-background-radius: 20;"/>
                    <Button text="Rafraichir" onAction="#handleRafraichir"
                            style="-fx-background-color: #E0DDD5; -fx-text-fill: #5D4037;
                                   -fx-background-radius: 20; -fx-padding: 9 18; -fx-cursor: hand;"/>
                    <Button text="Retour" onAction="#handleRetour"
                            style="-fx-background-color: #E0DDD5; -fx-text-fill: #5D4037;
                                   -fx-background-radius: 20; -fx-padding: 9 18; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Message vide -->
            <Label fx:id="lblAucuneProposition"
                   text="Aucune proposition trouvée pour le moment."
                   style="-fx-text-fill: #8D6E63; -fx-font-style: italic; -fx-font-size: 14;">
                <VBox.margin><Insets left="40"/></VBox.margin>
            </Label>

            <!-- Grille propositions groupées par matériau -->
            <VBox fx:id="propositionsContainer" spacing="32"
                  style="-fx-padding: 10 40 40 40;"/>

        </VBox>
    </content>
</ScrollPane>
