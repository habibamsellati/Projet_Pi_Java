<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.GestionLivraisonsController"
      spacing="16"
      style="-fx-background-color: #f5f0eb;"
      stylesheets="@/css/admin-dashboard.css">

    <padding>
        <Insets top="16" right="24" bottom="24" left="24"/>
    </padding>

    <!-- ── HEADER ── -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Gestion des Livraisons"
                   style="-fx-font-family: Georgia; -fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            <Label text="Liste et gestion des livraisons"
                   style="-fx-font-size: 12; -fx-text-fill: #888;"/>
        </VBox>
        <HBox style="-fx-background-color:white; -fx-border-color:#e0d8d0; -fx-border-radius:8; -fx-background-radius:8;"
              alignment="CENTER_LEFT" spacing="6" prefHeight="34" prefWidth="220">
            <padding><Insets left="10" right="10"/></padding>
            <Label text="..." style="-fx-text-fill:#bbb; -fx-font-size:13;"/>
            <TextField fx:id="tfRecherche" promptText="Rechercher une livraison..."
                       style="-fx-background-color:transparent; -fx-border-color:transparent; -fx-font-size:12;"
                       HBox.hgrow="ALWAYS"/>
        </HBox>
        <Button fx:id="btnExporter" text="⬇  Exporter en PDF" onAction="#handleExportPdf"
                style="-fx-background-color:#3b1f4e; -fx-text-fill:#e2d9f3; -fx-background-radius:8; -fx-padding:0 14; -fx-font-size:12; -fx-pref-height:34; -fx-cursor:hand;"/>
        <Button fx:id="btnAjouterLivraison" text="+ Ajouter livraison" onAction="#handleAjouter"
                style="-fx-background-color:#c8860a; -fx-text-fill:white; -fx-background-radius:8; -fx-padding:0 14; -fx-font-size:12; -fx-pref-height:34; -fx-font-weight:bold; -fx-cursor:hand;"/>
    </HBox>

    <!-- ── STAT CARDS ── -->
    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color:#3b1f4e; -fx-background-radius:12; -fx-padding:16 20;">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="🚚" style="-fx-font-size:12; -fx-text-fill:#c9b7d0;"/>
                <Label text="Total Livraisons" style="-fx-text-fill:#c9b7d0; -fx-font-size:11;"/>
            </HBox>
            <Label fx:id="lblTotal" text="0"
                   style="-fx-text-fill:white; -fx-font-size:36; -fx-font-weight:bold; -fx-padding: 4 0 2 0;"/>
            <Label text="livraisons enregistrees" style="-fx-text-fill:#c9b7d0; -fx-font-size:10; -fx-opacity:0.7;"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color:#0d4a35; -fx-background-radius:12; -fx-padding:16 20;">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="✔" style="-fx-font-size:12; -fx-text-fill:#6fcf97;"/>
                <Label text="Livrees" style="-fx-text-fill:#6fcf97; -fx-font-size:11;"/>
            </HBox>
            <Label fx:id="lblLivrees" text="0"
                   style="-fx-text-fill:white; -fx-font-size:36; -fx-font-weight:bold; -fx-padding: 4 0 2 0;"/>
            <Label text="livraisons completees" style="-fx-text-fill:#6fcf97; -fx-font-size:10; -fx-opacity:0.7;"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color:#7a4800; -fx-background-radius:12; -fx-padding:16 20;">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="⏳" style="-fx-font-size:12; -fx-text-fill:#fbbf24;"/>
                <Label text="En attente" style="-fx-text-fill:#fbbf24; -fx-font-size:11;"/>
            </HBox>
            <Label fx:id="lblEnAttente" text="0"
                   style="-fx-text-fill:white; -fx-font-size:36; -fx-font-weight:bold; -fx-padding: 4 0 2 0;"/>
            <Label text="en cours de traitement" style="-fx-text-fill:#fbbf24; -fx-font-size:10; -fx-opacity:0.7;"/>
        </VBox>
        <VBox visible="false" managed="false">
            <Label fx:id="lblEnCours" text="0"/>
        </VBox>
    </HBox>

    <!-- ── TABLE ��─ -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color:white; -fx-background-radius:12; -fx-border-color:#e8e0d8; -fx-border-radius:12; -fx-padding:0;">
        <TableView fx:id="tableLivraisons" VBox.vgrow="ALWAYS"
                   style="-fx-background-color:transparent; -fx-background-radius:12;">
            <columns>
                <TableColumn fx:id="colDate"     text="DATE"     prefWidth="220"/>
                <TableColumn fx:id="colAdresse"  text="ADRESSE"  prefWidth="420"/>
                <TableColumn fx:id="colStatut"   text="STATUT"   prefWidth="200"/>
                <TableColumn fx:id="colActions"  text="ACTIONS"  prefWidth="280"/>
            </columns>
        </TableView>
    </VBox>
</VBox>

