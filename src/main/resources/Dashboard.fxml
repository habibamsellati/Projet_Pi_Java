<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #F5F0EB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.DashboardController">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #2C1810;" BorderPane.alignment="CENTER">
            <children>

                <!-- LOGO -->
                <HBox alignment="CENTER" spacing="12.0">
                    <padding><Insets bottom="35.0" left="20.0" right="20.0" top="35.0" /></padding>
                    <children>
                        <VBox alignment="CENTER" prefWidth="42" prefHeight="42" style="-fx-background-color: #D4A373; -fx-background-radius: 12;">
                            <children>
                                <Label text="A" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox>
                            <children>
                                <Label text="afk'art" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label text="Gestion Livraisons" textFill="#A0856C">
                                    <font><Font size="10.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- SEPARATEUR -->
                <Region prefHeight="1" maxWidth="Infinity" style="-fx-background-color: #3D2418;"/>

                <!-- MENU -->
                <Label text="NAVIGATION" textFill="#6B4C3B" style="-fx-padding: 20 20 8 20;">
                    <font><Font name="System Bold" size="10.0" /></font>
                </Label>

                <VBox spacing="4.0" style="-fx-padding: 0 12 0 12;">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: transparent; -fx-text-fill: #A0856C; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 0 0 0 15;"
                                text="🏠  Dashboard" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: transparent; -fx-text-fill: #A0856C; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 0 0 0 15;"
                                text="👥  Utilisateurs" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: #D4A373; -fx-text-fill: #2C1810; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 0 0 0 15;"
                                text="📦  Livraisons">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: transparent; -fx-text-fill: #A0856C; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 0 0 0 15;"
                                text="🎨  Artisans" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color: transparent; -fx-text-fill: #A0856C; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 0 0 0 15;"
                                text="🛒  Commandes" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </left>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <AnchorPane fx:id="contentArea" style="-fx-background-color: #F5F0EB;" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="20.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="30.0" AnchorPane.bottomAnchor="20.0">
                    <children>

                        <!-- EN-TETE -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Gestion des Livraisons" textFill="#2C1810">
                                            <font><Font name="System Bold" size="26.0" /></font>
                                        </Label>
                                        <Label text="Suivi et gestion en temps réel" textFill="#A0856C">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- SEARCH -->
                                <HBox alignment="CENTER_LEFT" spacing="8" prefHeight="42" prefWidth="280"
                                      style="-fx-background-color: white; -fx-background-radius: 25; -fx-border-color: #E8DDD5; -fx-border-radius: 25; -fx-padding: 0 15 0 15;">
                                    <children>
                                        <Label text="🔍" />
                                        <TextField fx:id="searchField" prefHeight="38" prefWidth="230"
                                                   promptText="Rechercher une livraison..."
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                                    </children>
                                </HBox>

                                <!-- BOUTON PDF -->
                                <Button mnemonicParsing="false" onAction="#handleExportPDF"
                                        prefHeight="42.0" prefWidth="140.0"
                                        style="-fx-background-color: #5D4037; -fx-background-radius: 25; -fx-cursor: hand;"
                                        text="📥  Export PDF" textFill="WHITE">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Button>

                                <!-- BOUTON AJOUTER -->
                                <Button mnemonicParsing="false" onAction="#versAjouter"
                                        prefHeight="42.0" prefWidth="190.0"
                                        style="-fx-background-color: #D4A373; -fx-background-radius: 25; -fx-cursor: hand;"
                                        text="＋  Ajouter livraison" textFill="#2C1810">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </HBox>

                        <!-- CARTES STATISTIQUES -->
                        <HBox spacing="15.0">
                            <children>

                                <!-- TOTAL -->
                                <VBox HBox.hgrow="ALWAYS" prefHeight="100"
                                      style="-fx-background-color: #2C1810; -fx-background-radius: 20; -fx-padding: 20;">
                                    <children>
                                        <Label text="📦  Total Livraisons" textFill="#A0856C">
                                            <font><Font size="12.0"/></font>
                                        </Label>
                                        <Label fx:id="lblTotal" text="0" textFill="WHITE">
                                            <font><Font name="System Bold" size="36.0"/></font>
                                        </Label>
                                        <Label text="livraisons enregistrées" textFill="#6B4C3B">
                                            <font><Font size="11.0"/></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- LIVREES -->
                                <VBox HBox.hgrow="ALWAYS" prefHeight="100"
                                      style="-fx-background-color: #1B4332; -fx-background-radius: 20; -fx-padding: 20;">
                                    <children>
                                        <Label text="✅  Livrées" textFill="#74C69D">
                                            <font><Font size="12.0"/></font>
                                        </Label>
                                        <Label fx:id="lblLivrees" text="0" textFill="WHITE">
                                            <font><Font name="System Bold" size="36.0"/></font>
                                        </Label>
                                        <Label text="livraisons complétées" textFill="#40916C">
                                            <font><Font size="11.0"/></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- EN ATTENTE -->
                                <VBox HBox.hgrow="ALWAYS" prefHeight="100"
                                      style="-fx-background-color: #7C3D08; -fx-background-radius: 20; -fx-padding: 20;">
                                    <children>
                                        <Label text="⏳  En attente" textFill="#FFB347">
                                            <font><Font size="12.0"/></font>
                                        </Label>
                                        <Label fx:id="lblAttente" text="0" textFill="WHITE">
                                            <font><Font name="System Bold" size="36.0"/></font>
                                        </Label>
                                        <Label text="en cours de traitement" textFill="#CC7722">
                                            <font><Font size="11.0"/></font>
                                        </Label>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <!-- TABLEAU -->
                        <TableView fx:id="tableLivraisons" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #E8DDD5; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 4);">
                            <columns>
                                <TableColumn fx:id="colDate" prefWidth="200.0" text="DATE DE LIVRAISON" />
                                <TableColumn fx:id="colAdresse" prefWidth="280.0" text="ADRESSE" />
                                <TableColumn fx:id="colStatut" prefWidth="150.0" text="STATUT" />
                                <TableColumn fx:id="colActions" prefWidth="200.0" style="-fx-alignment: CENTER;" text="ACTIONS" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>