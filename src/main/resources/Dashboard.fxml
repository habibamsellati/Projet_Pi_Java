<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FDFBF7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.DashboardController">
    <left>
        <VBox prefWidth="260.0" style="-fx-background-color: #634652;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <padding>
                        <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
                    </padding>
                    <children>
                        <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#d4a373" height="40.0" width="40.0" />
                        <Label text="afk'art" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <Label text="MENU PRINCIPAL" textFill="#bcaaa4">
                    <VBox.margin><Insets left="20.0" top="10.0" /></VBox.margin>
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>

                <VBox spacing="5.0" style="-fx-padding: 15 0 0 0;">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #E0E0E0; -fx-cursor: hand;" text="   Dashboard" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #E0E0E0; -fx-cursor: hand;" text="   Utilisateurs" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: #4e3440; -fx-text-fill: white; -fx-cursor: hand;" text="   Livraisons">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #E0E0E0; -fx-cursor: hand;" text="   Artisans" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #E0E0E0; -fx-cursor: hand;" text="   Commandes" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>
                <VBox layoutX="40.0" layoutY="30.0" spacing="30.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="30.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Gestion des Livraisons" textFill="#5d4037">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Button mnemonicParsing="false" onAction="#versAjouter" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #8D6E63; -fx-background-radius: 30; -fx-cursor: hand;" text="+ Ajouter une livraison" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <TableView fx:id="tableLivraisons" prefHeight="500.0" style="-fx-background-radius: 10; -fx-border-color: #eee; -fx-border-radius: 10; -fx-background-color: white;">
                            <columns>
                                <TableColumn fx:id="colDate" prefWidth="180.0" text="DATE DE LIVRAISON" />
                                <TableColumn fx:id="colAdresse" prefWidth="250.0" text="ADRESSE" />
                                <TableColumn fx:id="colStatut" prefWidth="150.0" text="STATUT" />
                                <TableColumn fx:id="colActions" prefWidth="315.0" style="-fx-alignment: CENTER;" text="ACTIONS" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
