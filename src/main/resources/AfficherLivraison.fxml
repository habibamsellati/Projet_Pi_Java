<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #FDFBF7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AfficherLivraisoncontrollers">
