<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #FDFBF7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AjouterLivraisoncontrollers">
    <children>

        <HBox alignment="BOTTOM_LEFT" maxWidth="900.0" spacing="20.0">
            <padding>
                <Insets top="50.0" bottom="30.0" />
            </padding>
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Nouvelle Livraison" textFill="#2C1810">
                            <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                        <Label text="Gestion et planification des expéditions afk'art" textFill="#8D6E63">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </children>
                </VBox>
                <Button onAction="#retourListe" prefHeight="40.0" style="-fx-background-color: #2C1810; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 0 25; -fx-cursor: hand;" text="← Liste des livraisons" />
            </children>
        </HBox>

        <VBox maxWidth="900.0" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 20, 0, 0, 10);">
            <padding>
                <Insets bottom="50.0" left="60.0" right="60.0" top="50.0" />
            </padding>
            <children>

                <GridPane hgap="30.0" vgap="25.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="75.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="75.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>

                        <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C1810;" text="Date de livraison prévue" />
                                <DatePicker fx:id="datePicker" maxWidth="1.7976931348623157E308" prefHeight="48.0" promptText="Sélectionner une date"
                                            style="-fx-background-color: #FDFBF7; -fx-border-color: #F0E8E0; -fx-border-radius: 12; -fx-background-radius: 12;" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C1810;" text="Livreur assigné" />
                                <ComboBox fx:id="livreurCombo" maxWidth="1.7976931348623157E308" prefHeight="48.0" promptText="Choisir un membre..."
                                          style="-fx-background-color: #FDFBF7; -fx-border-color: #F0E8E0; -fx-border-radius: 12; -fx-background-radius: 12;" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C1810;" text="Référence Commande" />
                                <ComboBox fx:id="commandeCombo" maxWidth="1.7976931348623157E308" prefHeight="48.0" promptText="Sélectionner l'ID de commande"
                                          style="-fx-background-color: #FDFBF7; -fx-border-color: #F0E8E0; -fx-border-radius: 12; -fx-background-radius: 12;" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C1810;" text="Statut actuel" />
                                <HBox alignment="CENTER_LEFT" prefHeight="48.0">
                                    <children>
                                        <Label style="-fx-background-color: #FFF3E0; -fx-text-fill: #E67E22; -fx-padding: 8 20; -fx-background-radius: 20; -fx-font-weight: bold;" text="⌛ En attente" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <VBox spacing="10.0">
                    <children>
                        <Separator prefWidth="200.0" style="-fx-opacity: 0.3;" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C1810;" text="📍 Adresse de destination complète" />
                        <TextField fx:id="adresseField" prefHeight="55.0" promptText="Numéro, rue, ville, code postal..."
                                   style="-fx-background-color: #FDFBF7; -fx-border-color: #F0E8E0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 0 20;" />
                    </children>
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnCreer" onAction="#handleCreer" prefHeight="60.0" prefWidth="400.0"
                                style="-fx-background-color: #D4A373; -fx-text-fill: #2C1810; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 16; -fx-cursor: hand;"
                                text="+ Confirmer la livraison" />
                        <Label text="L'enregistrement notifiera automatiquement le livreur." textFill="#A0856C" style="-fx-font-size: 12;" />
                    </children>
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                </VBox>

            </children>
        </VBox>
    </children>
</VBox>