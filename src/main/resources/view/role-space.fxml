<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.RoleSpaceController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/role-space.css"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header">
            <children>
                <Label text="AfkArt" styleClass="logo"/>

                <Button text="Accueil" styleClass="nav-btn-flat"/>
                <Button text="Blog" styleClass="nav-btn-flat"/>
                <Button text="Livraisons" styleClass="nav-btn-flat"/>
                <Button text="Suivi Livraison" styleClass="nav-btn-flat"/>
                <Button text="Produits" styleClass="nav-btn-flat"/>
                <Button text="Propositions" styleClass="nav-btn-flat"/>
                <Button text="Événements" styleClass="nav-btn-flat"/>
                <Button text="Réservations" styleClass="nav-btn-flat"/>
                <Button text="Réclamations" styleClass="nav-btn-flat"/>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_LEFT" spacing="4.0" styleClass="profile-box">
                    <children>
                        <Label fx:id="userNameLabel" text="Nom Utilisateur" onMouseClicked="#handleOpenProfile" styleClass="profile-name-clickable"/>
                        <Label fx:id="userRoleLabel" text="(ROLE)" styleClass="profile-role"/>
                    </children>
                    <padding>
                        <Insets top="12" right="20" bottom="12" left="20"/>
                    </padding>
                </VBox>

                <Button text="Se déconnecter"
                        onAction="#handleLogout"
                        styleClass="logout-btn"/>
            </children>

            <padding>
                <Insets top="18" right="42" bottom="18" left="42"/>
            </padding>
        </HBox>
    </top>

    <center>
        <AnchorPane styleClass="content-area">

            <VBox alignment="CENTER" spacing="18.0"
                  AnchorPane.topAnchor="90.0"
                  AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0">

                <children>
                    <Label fx:id="pageTitleLabel" text="Espace Artisan" styleClass="page-title"/>
                    <Label fx:id="pageSubtitleLabel"
                           text="Gérez vos oeuvres, commandes et evenements."
                           styleClass="page-subtitle"/>

                    <HBox alignment="CENTER" spacing="34.0">
                        <children>

                            <VBox alignment="CENTER" spacing="18.0" prefWidth="360.0" prefHeight="260.0" styleClass="feature-card">
                                <children>
                                    <Label text="🎨" styleClass="card-icon"/>
                                    <Label fx:id="card1TitleLabel" text="Catalogue" styleClass="card-title"/>
                                    <Label fx:id="card1SubtitleLabel" text="Gestion des oeuvres." styleClass="card-subtitle"/>
                                </children>
                            </VBox>

                            <VBox alignment="CENTER" spacing="18.0" prefWidth="360.0" prefHeight="260.0" styleClass="feature-card">
                                <children>
                                    <Label text="📦" styleClass="card-icon"/>
                                    <Label fx:id="card2TitleLabel" text="Commandes" styleClass="card-title"/>
                                    <Label fx:id="card2SubtitleLabel" text="Suivi des ventes." styleClass="card-subtitle"/>
                                </children>
                            </VBox>

                            <VBox alignment="CENTER" spacing="18.0" prefWidth="360.0" prefHeight="260.0" styleClass="feature-card">
                                <children>
                                    <Label text="📅" styleClass="card-icon"/>
                                    <Label fx:id="card3TitleLabel" text="Evenements" styleClass="card-title"/>
                                    <Label fx:id="card3SubtitleLabel" text="Planning et reservation." styleClass="card-subtitle"/>
                                </children>
                            </VBox>

                        </children>
                    </HBox>
                </children>
            </VBox>
        </AnchorPane>
    </center>
</BorderPane>