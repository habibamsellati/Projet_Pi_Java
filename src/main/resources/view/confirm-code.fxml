<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.ConfirmCodeController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/confirm-code.css"
            styleClass="confirm-root">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="92.0" styleClass="confirm-header">
            <children>
                <Label text="AfkArt" styleClass="confirm-logo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Accueil" styleClass="confirm-nav-flat"/>
                <Button text="Connexion" onAction="#goToLogin" styleClass="confirm-nav-outline"/>
                <Button text="Rejoindre" styleClass="confirm-nav-primary"/>
            </children>
            <padding>
                <Insets top="18" right="42" bottom="18" left="42"/>
            </padding>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <children>
                <VBox alignment="CENTER"
                      spacing="18.0"
                      maxWidth="560.0"
                      styleClass="confirm-card">
                    <StackPane.margin>
                        <Insets top="40" bottom="40"/>
                    </StackPane.margin>
                    <padding>
                        <Insets top="42" right="46" bottom="34" left="46"/>
                    </padding>

                    <Label text="Confirmer votre email" styleClass="confirm-title"/>

                    <Label fx:id="emailInfoLabel"
                           text="Un code a été envoyé à votre email."
                           wrapText="true"
                           styleClass="confirm-subtitle"/>

                    <VBox spacing="10.0">
                        <children>
                            <Label text="Code de confirmation" styleClass="confirm-field-label"/>
                            <TextField fx:id="codeField"
                                       promptText="Entrez le code reçu"
                                       styleClass="confirm-input"/>
                        </children>
                    </VBox>

                    <Label fx:id="messageLabel"
                           wrapText="true"
                           maxWidth="420.0"
                           styleClass="confirm-message"/>

                    <Button text="Valider"
                            onAction="#handleConfirm"
                            maxWidth="Infinity"
                            styleClass="confirm-primary-btn"/>

                    <HBox alignment="CENTER">
                        <children>
                            <Button text="Retour connexion"
                                    onAction="#goToLogin"
                                    styleClass="confirm-link-btn"/>
                        </children>
                    </HBox>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>