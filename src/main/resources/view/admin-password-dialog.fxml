<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AdminPasswordDialogController"
      alignment="CENTER"
      spacing="16.0"
      prefWidth="380.0"
      prefHeight="240.0"
      stylesheets="@/style/admin-password-dialog.css"
      styleClass="dialog-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Accès sécurisé" styleClass="dialog-title"/>

    <Label text="Veuillez confirmer votre mot de passe administrateur."
           wrapText="true"
           styleClass="dialog-subtitle"/>

    <PasswordField fx:id="passwordField"
                   promptText="Mot de passe"
                   styleClass="dialog-input"/>

    <Label fx:id="errorLabel" text="" styleClass="dialog-error"/>

    <HBox alignment="CENTER" spacing="12.0">
        <children>
            <Button text="Annuler" onAction="#handleCancel" styleClass="cancel-btn"/>
            <Button text="Confirmer" onAction="#handleConfirm" styleClass="confirm-btn"/>
        </children>
    </HBox>
</VBox>