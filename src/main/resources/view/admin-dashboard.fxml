<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AdminDashboardController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/admin-back.css"
            styleClass="back-root">

    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sidebar-logo-box">
                    <children>
                        <Label text="⬢" styleClass="logo-icon"/>
                        <Label text="afk'art" styleClass="logo-text"/>
                    </children>
                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>
                </HBox>

                <VBox spacing="10.0" styleClass="menu-section">
                    <children>
                        <Label text="MENU PRINCIPAL" styleClass="menu-title"/>

                        <Button text="Dashboard"
                                onAction="#goToDashboard"
                                styleClass="sidebar-button sidebar-button-active"/>

                        <Button text="Utilisateurs"
                                onAction="#goToUsers"
                                styleClass="sidebar-button"/>

                        <Button text="Produits recyclables" styleClass="menu-btn"/>
                        <Button text="Propositions" styleClass="menu-btn"/>
                        <Button text="Livraison" styleClass="menu-btn"/>
                        <Button text="Réclamations" styleClass="menu-btn"/>
                        <Button text="Articles" styleClass="menu-btn"/>
                        <Button text="Evenements" styleClass="menu-btn"/>
                        <Button text="Réservations" styleClass="menu-btn"/>
                        <Button text="Suivi livraison" styleClass="menu-btn"/>
                        <Button text="Aller au Front"
                                onAction="#goToFront"
                                styleClass="front-button"/>
                    </children>
                    <padding>
                        <Insets top="20" right="14" bottom="10" left="14"/>
                    </padding>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="26.0" styleClass="main-content">
            <padding>
                <Insets top="26" right="34" bottom="26" left="34"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="18.0">
                    <children>
                        <Button text="←" onAction="#handleBack" styleClass="back-arrow-btn"/>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Dashboard" styleClass="page-title"/>
                                <Label text="Bienvenue, Administrateur" styleClass="page-subtitle"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <TextField promptText="Rechercher..." styleClass="top-search"/>

                        <Button text="🔔" styleClass="icon-btn"/>

                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="admin-chip">
                            <children>
                                <Label text="AD" styleClass="avatar-circle"/>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label fx:id="userNameLabel" text="Admin" styleClass="chip-name"/>
                                        <Label fx:id="userRoleLabel" text="Super Admin" styleClass="chip-role"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox spacing="22.0">
                    <children>
                        <HBox spacing="16.0" prefWidth="300.0" prefHeight="130.0" styleClass="stat-card">
                            <children>
                                <StackPane prefWidth="64.0" prefHeight="64.0" styleClass="stat-icon-box purple-box">
                                    <children>
                                        <Label text="👥" styleClass="stat-icon"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="875" styleClass="stat-value"/>
                                        <Label text="Utilisateurs" styleClass="stat-label"/>
                                        <Label text="+12.5%" styleClass="stat-badge green-badge"/>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>
                        </HBox>

                        <HBox spacing="16.0" prefWidth="300.0" prefHeight="130.0" styleClass="stat-card">
                            <children>
                                <StackPane prefWidth="64.0" prefHeight="64.0" styleClass="stat-icon-box gold-box">
                                    <children>
                                        <Label text="🖼" styleClass="stat-icon"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="214" styleClass="stat-value"/>
                                        <Label text="Oeuvres" styleClass="stat-label"/>
                                        <Label text="+8.2%" styleClass="stat-badge green-badge"/>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>
                        </HBox>

                        <HBox spacing="16.0" prefWidth="300.0" prefHeight="130.0" styleClass="stat-card">
                            <children>
                                <StackPane prefWidth="64.0" prefHeight="64.0" styleClass="stat-icon-box green-box">
                                    <children>
                                        <Label text="🛠" styleClass="stat-icon"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="153" styleClass="stat-value"/>
                                        <Label text="Artisans" styleClass="stat-label"/>
                                        <Label text="+5.7%" styleClass="stat-badge green-badge"/>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>
                        </HBox>

                        <HBox spacing="16.0" prefWidth="300.0" prefHeight="130.0" styleClass="stat-card">
                            <children>
                                <StackPane prefWidth="64.0" prefHeight="64.0" styleClass="stat-icon-box orange-box">
                                    <children>
                                        <Label text="⚠" styleClass="stat-icon"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="32" styleClass="stat-value"/>
                                        <Label text="Signalements" styleClass="stat-label"/>
                                        <Label text="-3.1%" styleClass="stat-badge red-badge"/>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>
                        </HBox>
                    </children>
                </HBox>

                <HBox spacing="22.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="860.0" styleClass="panel-card" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Activite de la plateforme" styleClass="panel-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="7 jours" styleClass="period-btn active-period-btn"/>
                                        <Button text="30 jours" styleClass="period-btn"/>
                                        <Button text="12 mois" styleClass="period-btn"/>
                                    </children>
                                </HBox>

                                <StackPane prefHeight="330.0" styleClass="chart-placeholder">
                                    <children>
                                        <Label text="Zone graphique activité" styleClass="placeholder-text"/>
                                    </children>
                                </StackPane>
                            </children>
                            <padding>
                                <Insets top="22" right="22" bottom="22" left="22"/>
                            </padding>
                        </VBox>

                        <VBox prefWidth="360.0" styleClass="panel-card">
                            <children>
                                <Label text="Repartition des roles" styleClass="panel-title"/>

                                <StackPane prefHeight="220.0" styleClass="chart-placeholder small-chart">
                                    <children>
                                        <Label text="1042&#10;Total" styleClass="donut-placeholder"/>
                                    </children>
                                </StackPane>

                                <GridPane hgap="12.0" vgap="14.0">
                                    <children>
                                        <Label text="■ Utilisateurs" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="legend-item users-color"/>
                                        <Label text="70%" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="legend-value"/>

                                        <Label text="■ Artisans" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="legend-item artisans-color"/>
                                        <Label text="20%" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="legend-value"/>

                                        <Label text="■ Admins" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="legend-item admins-color"/>
                                        <Label text="10%" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="legend-value"/>
                                    </children>
                                </GridPane>
                            </children>
                            <padding>
                                <Insets top="22" right="22" bottom="22" left="22"/>
                            </padding>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>