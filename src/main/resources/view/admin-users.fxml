<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AdminUsersController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/admin-back.css"
            styleClass="back-root">

    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sidebar-logo-box">
                    <children>
                        <Label text="⬢" styleClass="logo-icon"/>
                        <Label text="afk'art" styleClass="logo-text"/>
                    </children>
                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>
                </HBox>

                <VBox spacing="10.0" styleClass="menu-section">
                    <children>
                        <Label text="MENU PRINCIPAL" styleClass="menu-title"/>

                        <Button text="Dashboard" onAction="#goToDashboard" styleClass="menu-btn"/>
                        <Button text="Utilisateurs" onAction="#goToUsers" styleClass="menu-btn active-menu-btn"/>
                        <Button text="Produits recyclables" styleClass="menu-btn"/>
                        <Button text="Propositions" styleClass="menu-btn"/>
                        <Button text="Livraison" styleClass="menu-btn"/>
                        <Button text="Réclamations" styleClass="menu-btn"/>
                        <Button text="Articles" styleClass="menu-btn"/>
                        <Button text="Evenements" styleClass="menu-btn"/>
                        <Button text="Réservations" styleClass="menu-btn"/>
                        <Button text="Suivi livraison" styleClass="menu-btn"/>
                        <Button text="Aller au Front" onAction="#goToFront" styleClass="menu-btn accent-menu-btn"/>
                    </children>
                    <padding>
                        <Insets top="20" right="14" bottom="10" left="14"/>
                    </padding>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane alignment="TOP_LEFT">
            <children>
                <!-- largeur contrôlée pour que le blanc du tableau ne dépasse pas -->
                <VBox spacing="20.0"
                      maxWidth="1310.0"
                      prefWidth="1310.0"
                      styleClass="main-content">
                    <padding>
                        <Insets top="26" right="26" bottom="26" left="36"/>
                    </padding>

                    <children>
                        <!-- barre haute -->
                        <HBox alignment="CENTER_LEFT" spacing="18.0">
                            <children>
                                <Button text="←" onAction="#handleBack" styleClass="back-arrow-btn"/>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Gestion des Utilisateurs" styleClass="page-title"/>
                                        <Label text="Liste et gestion des comptes" styleClass="page-subtitle"/>
                                    </children>
                                </VBox>

                                <!-- espace contrôlé au lieu de pousser tout au bord -->
                                <Region minWidth="250.0" prefWidth="250.0"/>

                                <TextField promptText="Rechercher..." styleClass="top-search"/>
                                <Button text="🔔" styleClass="icon-btn"/>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="12.0"
                                      styleClass="admin-chip"
                                      translateX="-8">
                                    <children>
                                        <Label text="AD" styleClass="avatar-circle"/>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label fx:id="userNameLabel" text="Admin" styleClass="chip-name"/>
                                                <Label fx:id="userRoleLabel" text="ADMIN" styleClass="chip-role"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Label text="Liste et gestion des comptes utilisateurs" styleClass="simple-text"/>

                        <!-- barre recherche + actions -->
                        <HBox spacing="14.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Rechercher (nom, prénom, email...)"
                                           styleClass="filter-field"/>

                                <ComboBox fx:id="sortComboBox"
                                          onAction="#handleSort"
                                          promptText="Trier par"
                                          styleClass="edit-combo"
                                          prefWidth="170.0"/>

                                <Button text="Rechercher" onAction="#handleSearch" styleClass="dark-btn"/>
                                <Button text="Corbeille" styleClass="dark-btn"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button text="Exporter en PDF" onAction="#handleExportPdf" styleClass="green-btn"/>
                                <Button text="Ajouter un utilisateur" onAction="#goToAddUser" styleClass="orange-btn"/>
                            </children>
                        </HBox>

                        <!-- header + liste avec même largeur -->
                        <VBox spacing="0.0" maxWidth="1310.0" prefWidth="1310.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox fx:id="tableHeaderContainer"
                                      maxWidth="1310.0"
                                      prefWidth="1310.0"
                                      styleClass="users-header-container"/>

                                <ListView fx:id="usersListView"
                                          maxWidth="1310.0"
                                          prefWidth="1310.0"
                                          VBox.vgrow="ALWAYS"
                                          styleClass="users-list-view"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>