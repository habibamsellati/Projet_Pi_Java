<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ModuleLoginDialogController"
      alignment="CENTER"
      spacing="14.0"
      prefWidth="380.0"
      prefHeight="280.0"
      style="-fx-background-color: white; -fx-background-radius: 18;">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <children>
        <Label text="Accès au module"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #5b4534;"/>

        <Label fx:id="moduleTitleLabel"
               text="Module"
               style="-fx-font-size: 14px; -fx-text-fill: #8b6f5a;"/>

        <TextField fx:id="usernameField"
                   promptText="Nom d'utilisateur"
                   style="-fx-pref-height: 42; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d7c8bb;"/>

        <PasswordField fx:id="passwordField"
                       promptText="Mot de passe"
                       style="-fx-pref-height: 42; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d7c8bb;"/>

        <Label fx:id="messageLabel"
               wrapText="true"
               style="-fx-text-fill: red; -fx-font-size: 13px;"/>

        <Button text="Valider"
                onAction="#handleValidate"
                maxWidth="Infinity"
                style="-fx-pref-height: 42; -fx-background-color: linear-gradient(to right, #cf7e4b, #de9460); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>

        <Button text="Annuler"
                onAction="#handleCancel"
                maxWidth="Infinity"
                style="-fx-pref-height: 40; -fx-background-color: transparent; -fx-border-color: #cbb9aa; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #6a5240;"/>
    </children>
</VBox>