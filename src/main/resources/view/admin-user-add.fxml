<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AdminUserAddController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/admin-back.css"
            styleClass="back-root">

    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sidebar-logo-box">
                    <children>
                        <Label text="⬢" styleClass="logo-icon"/>
                        <Label text="afk'art" styleClass="logo-text"/>
                    </children>
                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>
                </HBox>

                <VBox spacing="10.0" styleClass="menu-section">
                    <children>
                        <Label text="MENU PRINCIPAL" styleClass="menu-title"/>
                        <Button text="Dashboard" onAction="#goToDashboard" styleClass="menu-btn"/>
                        <Button text="Utilisateurs" onAction="#goToUsers" styleClass="menu-btn active-menu-btn"/>
                        <Button text="Produits recyclables" styleClass="menu-btn"/>
                        <Button text="Propositions" styleClass="menu-btn"/>
                        <Button text="Livraison" styleClass="menu-btn"/>
                        <Button text="Réclamations" styleClass="menu-btn"/>
                        <Button text="Articles" styleClass="menu-btn"/>
                        <Button text="Evenements" styleClass="menu-btn"/>
                        <Button text="Réservations" styleClass="menu-btn"/>
                        <Button text="Suivi livraison" styleClass="menu-btn"/>
                        <Button text="Aller au Front" onAction="#goToFront" styleClass="menu-btn accent-menu-btn"/>
                    </children>
                    <padding>
                        <Insets top="20" right="14" bottom="10" left="14"/>
                    </padding>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="center-scroll">

            <content>
                <VBox spacing="20.0" styleClass="main-content">
                    <padding>
                        <Insets top="26" right="34" bottom="26" left="34"/>
                    </padding>

                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="18.0">
                            <children>
                                <Button text="←" onAction="#handleBack" styleClass="back-arrow-btn"/>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Ajouter un utilisateur" styleClass="page-title"/>
                                        <Label text="Créer un nouveau compte utilisateur" styleClass="page-subtitle"/>
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <TextField promptText="Rechercher..." styleClass="top-search"/>
                                <Button text="🔔" styleClass="icon-btn"/>

                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="admin-chip">
                                    <children>
                                        <Label text="AD" styleClass="avatar-circle"/>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label fx:id="userNameLabel" text="Admin" styleClass="chip-name"/>
                                                <Label fx:id="userRoleLabel" text="ADMIN" styleClass="chip-role"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <HBox alignment="TOP_CENTER">
                            <children>
                                <VBox prefWidth="460.0" maxWidth="460.0" spacing="12.0" styleClass="edit-card">
                                    <children>
                                        <Label text="Nouveau compte" styleClass="edit-big-title"/>
                                        <Label text="Remplissez les informations du nouvel utilisateur" styleClass="edit-subtitle"/>

                                        <Label text="Prénom *" styleClass="edit-label"/>
                                        <TextField fx:id="prenomField" styleClass="edit-input"/>

                                        <Label text="Nom *" styleClass="edit-label"/>
                                        <TextField fx:id="nomField" styleClass="edit-input"/>

                                        <Label text="Email *" styleClass="edit-label"/>
                                        <TextField fx:id="emailField" styleClass="edit-input"/>

                                        <Label text="Mot de passe *" styleClass="edit-label"/>
                                        <PasswordField fx:id="passwordField" styleClass="edit-input"/>

                                        <Label text="Rôle *" styleClass="edit-label"/>
                                        <ComboBox fx:id="roleComboBox" styleClass="edit-combo"/>

                                        <Label text="Statut *" styleClass="edit-label"/>
                                        <ComboBox fx:id="statutComboBox" styleClass="edit-combo"/>

                                        <Label text="Sexe" styleClass="edit-label"/>
                                        <ComboBox fx:id="sexeComboBox" styleClass="edit-combo"/>

                                        <Label text="Téléphone" styleClass="edit-label"/>
                                        <TextField fx:id="telephoneField" styleClass="edit-input"/>

                                        <Button text="Ajouter l'utilisateur"
                                                onAction="#handleAddUser"
                                                styleClass="big-full-btn"/>

                                        <Button text="← Retour à la liste"
                                                onAction="#goToUsers"
                                                styleClass="link-btn"/>

                                        <Label fx:id="messageLabel" text="" wrapText="true" styleClass="message-label"/>
                                    </children>
                                    <padding>
                                        <Insets top="24" right="24" bottom="24" left="24"/>
                                    </padding>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>