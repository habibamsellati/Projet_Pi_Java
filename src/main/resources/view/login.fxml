<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.LoginController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/login.css"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="72.0" styleClass="header">
            <children>
                <Label text="AfkArt" styleClass="logo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Accueil" styleClass="nav-btn-flat"/>
                <Button text="Connexion" styleClass="nav-btn-outline"/>
                <Button text="Rejoindre" styleClass="nav-btn-primary"/>
            </children>
            <padding>
                <Insets top="12" right="42" bottom="12" left="42"/>
            </padding>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <children>
                <VBox alignment="TOP_CENTER" spacing="16.0" maxWidth="470.0" styleClass="card">
                    <padding>
                        <Insets top="42" right="42" bottom="36" left="42"/>
                    </padding>

                    <Label text="Se connecter" styleClass="title"/>
                    <Label text="Accédez à votre compte AfkArt" styleClass="subtitle"/>

                    <VBox alignment="TOP_LEFT" spacing="8">
                        <children>
                            <Label text="Email" styleClass="field-label-chip"/>
                            <TextField fx:id="emailField" styleClass="input"/>
                        </children>
                    </VBox>

                    <VBox alignment="TOP_LEFT" spacing="8">
                        <children>
                            <Label text="Mot de passe" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField" styleClass="input"/>
                        </children>
                    </VBox>

                    <Button text="Se connecter"
                            maxWidth="Infinity"
                            onAction="#handleLogin"
                            styleClass="btn-primary"/>

                    <!-- 🔥 AJOUT ERREUR -->
                    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

                    <HBox alignment="CENTER" spacing="10">
                        <children>
                            <Separator prefWidth="120"/>
                            <Label text="ou continuer avec" styleClass="divider"/>
                            <Separator prefWidth="120"/>
                        </children>
                    </HBox>

                    <Button text="Google" maxWidth="Infinity" styleClass="btn-google"/>
                    <Button text="Facebook" maxWidth="Infinity" styleClass="btn-facebook"/>

                    <Hyperlink text="Mot de passe oublié ?" styleClass="forgot-link"/>

                    <HBox alignment="CENTER" spacing="4">
                        <children>
                            <Label text="Pas encore de compte ?" styleClass="bottom-text"/>
                            <Hyperlink text="S'inscrire" onAction="#goToSignup" styleClass="signup-link"/>
                        </children>
                    </HBox>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>