<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.SignupController"
            prefWidth="1600.0"
            prefHeight="900.0"
            stylesheets="@/style/signup.css"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="72.0" styleClass="header">
            <children>
                <Label text="AfkArt" styleClass="logo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Accueil" styleClass="nav-btn-flat"/>
                <Button text="Connexion" onAction="#goToLogin" styleClass="nav-btn-outline"/>
                <Button text="Rejoindre" styleClass="nav-btn-primary"/>
            </children>
            <padding>
                <Insets top="12" right="42" bottom="12" left="42"/>
            </padding>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <children>
                <VBox alignment="TOP_LEFT" spacing="10.0" maxWidth="470.0" styleClass="card">
                    <padding>
                        <Insets top="30" right="34" bottom="24" left="34"/>
                    </padding>

                    <Label text="Créer un compte" styleClass="title"/>
                    <Label text="Rejoignez AfkArt et découvrez l'art qui donne une seconde vie"
                           wrapText="true"
                           styleClass="subtitle"/>

                    <Label text="Nom" styleClass="field-label"/>
                    <TextField fx:id="nomField" promptText="Entrez votre nom" styleClass="input"/>

                    <Label text="Prénom" styleClass="field-label"/>
                    <TextField fx:id="prenomField" promptText="Entrez votre prénom" styleClass="input"/>

                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField" promptText="Entrez votre email" styleClass="input"/>

                    <Label text="Mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" styleClass="input"/>

                    <Label text="Téléphone" styleClass="field-label"/>
                    <TextField fx:id="telephoneField" promptText="Entrez votre numéro de téléphone" styleClass="input"/>

                    <ComboBox fx:id="sexeComboBox" promptText="Sélectionner le sexe"/>

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="info-box">
                        <children>
                            <Label text="👤" styleClass="avatar-icon"/>
                            <Label text="L'avatar est généré automatiquement selon le sexe choisi."
                                   wrapText="true"
                                   styleClass="info-text"/>
                        </children>
                    </HBox>

                    <ComboBox fx:id="roleComboBox" promptText="Sélectionner le rôle"/>

                    <Label fx:id="messageLabel" styleClass="message-label"/>

                    <Button text="S'inscrire"
                            onAction="#handleSignup"
                            maxWidth="Infinity"
                            styleClass="btn-primary"/>

                    <HBox alignment="CENTER" spacing="4">
                        <children>
                            <Label text="Vous avez déjà un compte ?" styleClass="bottom-text"/>
                            <Hyperlink text="Se connecter" onAction="#goToLogin" styleClass="signup-link"/>
                        </children>
                    </HBox>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>